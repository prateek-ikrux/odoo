<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- CRM already owns a settings page, so this adds a block to it rather
         than a second tab. Reachable at CRM > Configuration > Settings. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.crm.meeting.reminders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="crm.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='crm']" position="inside">
                <block title="Meeting Reminders" name="crm_meeting_reminders">
                    <setting id="crm_meeting_reminders_setting"
                             string="Meeting Reminders"
                             help="Warn by email before a meeting linked to an opportunity. Odoo's own per-meeting reminders are unaffected.">
                        <field name="crm_meeting_reminders_enabled"/>
                        <div class="content-group"
                             invisible="not crm_meeting_reminders_enabled">
                            <div class="row mt16">
                                <label for="crm_meeting_reminder_hours"
                                       string="Remind at (hours before)"
                                       class="col-lg-4 o_light_label"/>
                                <field name="crm_meeting_reminder_hours"
                                       placeholder="48,24,12,1"/>
                            </div>
                            <div class="row">
                                <label for="crm_meeting_reminder_cc"
                                       string="Always copy"
                                       class="col-lg-4 o_light_label"/>
                                <field name="crm_meeting_reminder_cc"
                                       placeholder="sales-ops@example.com, director@example.com"/>
                            </div>
                            <div class="row">
                                <label for="crm_meeting_reminder_from"
                                       string="Send from"
                                       class="col-lg-4 o_light_label"/>
                                <field name="crm_meeting_reminder_from"
                                       placeholder="service@example.com"/>
                            </div>
                            <div class="text-muted mt8">
                                Attendees who have not declined are on the To line;
                                the copy list is on Cc. Replies go to the organiser.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
