<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seed values only. These are edited under CRM > Configuration >
         Settings, which writes straight back to these parameters; noupdate
         keeps those edits from being reverted by an upgrade. -->
    <data noupdate="1">

        <record id="reminder_hours_param" model="ir.config_parameter">
            <field name="key">crm_meeting_reminders.hours</field>
            <field name="value">48,24,12,1</field>
        </record>

        <!-- Copied on every reminder regardless of attendance. Empty on
             install so a fresh database never mails anyone unexpected. -->
        <record id="reminder_cc_param" model="ir.config_parameter">
            <field name="key">crm_meeting_reminders.cc_emails</field>
            <field name="value"></field>
        </record>

        <!-- Sent from a mailbox the outgoing server is allowed to send as,
             rather than the organiser, whose address it usually is not. -->
        <record id="reminder_from_param" model="ir.config_parameter">
            <field name="key">crm_meeting_reminders.email_from</field>
            <field name="value">service@ikrux.com</field>
        </record>

    </data>
</odoo>
