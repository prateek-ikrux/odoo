<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No noupdate: the wording carries no user-owned state, so reworded
         copy should land on the next upgrade. The recipients, the sender and
         the schedule all come from the settings, not from here. -->
    <data>

        <record id="mail_template_crm_meeting_reminder" model="mail.template">
            <field name="name">CRM: Meeting Reminder</field>
            <field name="model_id" ref="calendar.model_calendar_event"/>
            <field name="subject">Reminder: {{ object.name }} in {{ ctx.get('reminder_hours') }} hour(s)</field>
            <!-- email_to, email_cc, email_from and reply_to are all supplied
                 per send by the cron, from the settings. -->
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent by the scheduled action ahead of a meeting linked to an opportunity.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p>
                        <strong t-out="object.name or ''"/> starts in
                        <strong><t t-out="ctx.get('reminder_hours') or ''"/> hour(s)</strong>.
                    </p>

                    <table width="100%" style="border-collapse: collapse; margin: 16px 0;">
                        <tr>
                            <td style="padding: 4px 12px 4px 0; color: #888888;">When</td>
                            <td style="padding: 4px 0;">
                                <strong t-out="format_datetime(object.start, tz=object.event_tz or user.tz or 'UTC', dt_format='EEEE d MMMM y, HH:mm') or ''"/>
                                <span style="color: #888888;">
                                    (<t t-out="object.event_tz or user.tz or 'UTC'"/>)
                                </span>
                            </td>
                        </tr>
                        <tr t-if="not object.allday">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Duration</td>
                            <td style="padding: 4px 0;"><t t-out="object.duration or 0"/> hour(s)</td>
                        </tr>
                        <tr t-if="object.opportunity_id">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Opportunity</td>
                            <td style="padding: 4px 0;"><t t-out="object.opportunity_id.name or ''"/></td>
                        </tr>
                        <tr t-if="object.opportunity_id.partner_id">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Client</td>
                            <td style="padding: 4px 0;"><t t-out="object.opportunity_id.partner_id.name or ''"/></td>
                        </tr>
                        <tr t-if="object.user_id">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Organiser</td>
                            <td style="padding: 4px 0;"><t t-out="object.user_id.name or ''"/></td>
                        </tr>
                        <tr t-if="object.location">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Location</td>
                            <td style="padding: 4px 0;"><t t-out="object.location or ''"/></td>
                        </tr>
                        <tr t-if="object.videocall_location">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Meeting URL</td>
                            <td style="padding: 4px 0;">
                                <a t-att-href="object.videocall_location" t-out="object.videocall_location or ''"/>
                            </td>
                        </tr>
                        <tr t-if="object.attendee_ids">
                            <td style="padding: 4px 12px 4px 0; color: #888888;">Attendees</td>
                            <td style="padding: 4px 0;">
                                <t t-out="object._reminder_attendee_names()"/>
                            </td>
                        </tr>
                    </table>

                    <div t-if="object.description and not is_html_empty(object.description)"
                         style="margin: 16px 0;">
                        <div style="color: #888888;">Description</div>
                        <div t-out="object.description"/>
                    </div>

                    <p style="color: #888888;">
                        Sent automatically ahead of this meeting.
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>
