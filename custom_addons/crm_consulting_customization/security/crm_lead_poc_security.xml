<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        A POC is seen by whoever can see its opportunity, and nobody else.
        Record rules do not follow a many2one on their own, so CRM's own
        crm.lead rules are repeated here through lead_id: a salesperson sees
        the POCs of their own and unassigned opportunities and of those they
        are a BDA on, "All Leads" sees every one, and each company keeps to
        its own.
    -->
    <record id="crm_lead_poc_rule_personal" model="ir.rule">
        <field name="name">Opportunity POCs: Personal</field>
        <field name="model_id" ref="model_crm_lead_poc"/>
        <field name="domain_force">['|', '|', ('lead_id.user_id', '=', user.id), ('lead_id.user_id', '=', False), ('lead_id.bda_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="crm_lead_poc_rule_all" model="ir.rule">
        <field name="name">Opportunity POCs: All</field>
        <field name="model_id" ref="model_crm_lead_poc"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
    </record>

    <record id="crm_lead_poc_rule_company" model="ir.rule">
        <field name="name">Opportunity POCs: Multi-Company</field>
        <field name="model_id" ref="model_crm_lead_poc"/>
        <field name="domain_force">[('lead_id.company_id', 'in', company_ids + [False])]</field>
    </record>
</odoo>
