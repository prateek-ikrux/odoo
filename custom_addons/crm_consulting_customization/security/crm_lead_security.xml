<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Every BDA on an opportunity sees it, not only the primary one.

        CRM's own "Personal Leads" rule lets a salesperson on "Own documents
        only" see what they are the Salesperson of - here the Primary BDA -
        and nothing about the rest of the BDA list. This rule is added beside
        it rather than rewriting it: rules of a user's groups are OR-ed, so it
        can only widen what a salesperson sees, by exactly the opportunities
        they are a BDA on, and CRM's rule stays CRM's. "All documents" and
        the multi-company rule are untouched.
    -->
    <record id="crm_rule_bda_lead" model="ir.rule">
        <field name="name">Opportunities: Every BDA</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="domain_force">[('bda_ids', 'in', user.id)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
</odoo>
