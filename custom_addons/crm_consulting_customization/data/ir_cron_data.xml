<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate: the schedules are the Admin's. Whether anything is sent is
         decided by the toggles in CRM settings, which every job reads on each
         run. The Stage Ageing and Client Inactivity report jobs run daily at
         the time picked for each in CRM settings - saving the settings moves
         them there - and send only on the days its frequency names. -->
    <data noupdate="1">

        <record id="ir_cron_crm_stage_reminders" model="ir.cron">
            <field name="name">CRM: Stage Ageing Report</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_stage_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_crm_inactivity_report" model="ir.cron">
            <field name="name">CRM: Client Inactivity Report</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_inactivity_report()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_crm_activity_reminders" model="ir.cron">
            <field name="name">CRM: Activity Reminders</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_crm_activity_reminders()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
