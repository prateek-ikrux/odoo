<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Third section: the candidates hired through an FTE MSA. A hire, not
         a contract - no period, no state - under the MSA it was made through,
         whose client and guarantee period it takes.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_contracts_fte_placement_list" model="ir.ui.view">
        <field name="name">contracts.fte.placement.list</field>
        <field name="model">contracts.fte.placement</field>
        <field name="arch" type="xml">
            <list string="FTE Placements">
                <field name="candidate"/>
                <field name="date_of_joining" widget="contracts_date"/>
                <field name="skillset" optional="show"/>
                <field name="offered_ctc" optional="show"/>
                <field name="client"/>
                <field name="fee_type" optional="show"/>
                <field name="fee_value" optional="show"/>
                <field name="billing_date" widget="contracts_date" optional="show"/>
                <field name="msa_id" optional="hide" context="{'contracts_show_period': True}"/>
                <field name="guarantee_period" optional="hide"/>
                <field name="guarantee_end_date" widget="contracts_date" optional="hide"/>
                <field name="create_uid" string="Created By" widget="many2one_avatar_user"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_contracts_fte_placement_form" model="ir.ui.view">
        <field name="name">contracts.fte.placement.form</field>
        <field name="model">contracts.fte.placement</field>
        <field name="arch" type="xml">
            <form string="FTE Placement">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_msa"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-level-up"
                                invisible="not msa_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">MSA</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="candidate"/>
                        <h1>
                            <field name="candidate" placeholder="Candidate hired..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Hire" name="hire">
                            <field name="date_of_joining" widget="contracts_date"/>
                            <field name="skillset" placeholder="e.g. Java, Spring Boot"/>
                            <field name="offered_ctc"/>
                        </group>
                        <group string="Client" name="client">
                            <!-- Only FTE and FTE/Consulting MSAs are offered, each
                                 with its period to tell them apart. -->
                            <field name="msa_id"
                                   options="{'no_create': True}"
                                   context="{'contracts_show_period': True}"/>
                            <field name="client" placeholder="Taken from the MSA"/>
                            <field name="guarantee_period"/>
                            <field name="guarantee_end_date" widget="contracts_date"
                                   invisible="not guarantee_end_date"/>
                            <field name="converted_from_sow_id"
                                   invisible="not converted_from_sow_id"/>
                        </group>
                    </group>
                    <group string="Fee" name="fee">
                        <group>
                            <field name="fee_type" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="fee_value"/>
                        </group>
                        <group>
                            <field name="billing_date" widget="contracts_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_contracts_fte_placement_search" model="ir.ui.view">
        <field name="name">contracts.fte.placement.search</field>
        <field name="model">contracts.fte.placement</field>
        <field name="arch" type="xml">
            <search string="Search FTE Placements">
                <field name="candidate"/>
                <field name="client"/>
                <field name="skillset"/>
                <field name="msa_id"/>
                <filter name="filter_percentage" string="Claimed %"
                        domain="[('fee_type', '=', 'percentage')]"/>
                <filter name="filter_flat" string="Flat Rate"
                        domain="[('fee_type', '=', 'flat')]"/>
                <separator/>
                <filter name="filter_in_guarantee" string="In Guarantee Period"
                        domain="[('guarantee_end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_converted" string="Converted from SOW"
                        domain="[('converted_from_sow_id', '!=', False)]"/>
                <separator/>
                <filter name="filter_doj" string="DOJ" date="date_of_joining"/>
                <filter name="filter_billing_date" string="Billing Date" date="billing_date"/>
                <group>
                    <filter name="group_client" string="Client" domain="[]" context="{'group_by': 'client'}"/>
                    <filter name="group_msa" string="MSA" domain="[]" context="{'group_by': 'msa_id'}"/>
                    <filter name="group_fee_type" string="Claimed % or Flat Rate" domain="[]"
                            context="{'group_by': 'fee_type'}"/>
                    <filter name="group_doj" string="DOJ" domain="[]"
                            context="{'group_by': 'date_of_joining'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Convert to FTE ──────────────────────────────────────────── -->
    <record id="view_contracts_fte_conversion_form" model="ir.ui.view">
        <field name="name">contracts.fte.conversion.form</field>
        <field name="model">contracts.fte.conversion</field>
        <field name="arch" type="xml">
            <form string="Convert to FTE">
                <div class="alert alert-info mb-3" role="alert">
                    <strong><field name="candidate" readonly="1" class="d-inline"/></strong>
                    is being hired by <field name="client" readonly="1" class="d-inline"/>.
                    The SOW will be terminated as of the date of joining, and the
                    candidate recorded as an FTE placement under the same MSA.
                </div>
                <field name="sow_id" invisible="1"/>
                <group>
                    <group string="Hire">
                        <field name="date_of_joining" widget="contracts_date"/>
                        <field name="skillset"/>
                        <field name="offered_ctc"/>
                    </group>
                    <group string="Fee">
                        <field name="msa_id" readonly="1" context="{'contracts_show_period': True}"/>
                        <field name="fee_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="fee_value"/>
                        <field name="billing_date" widget="contracts_date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_convert" string="Convert to FTE" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_contracts_fte_placement" model="ir.actions.act_window">
        <field name="name">FTE Placements</field>
        <field name="res_model">contracts.fte.placement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_contracts_fte_placement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first FTE placement</p>
            <p>
                Every candidate hired by a client through an FTE or
                FTE/Consulting MSA.
            </p>
        </field>
    </record>

</odoo>
