<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Base views. These carry the fields common to every contract and are
         used as-is by the first section; the second section derives from
         them below, adding the fields that only apply to a placement.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── List ───────────────────────────────────────────────────────── -->
    <record id="view_contracts_contract_list" model="ir.ui.view">
        <field name="name">contracts.contract.list</field>
        <field name="model">contracts.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts"
                  decoration-success="state == 'active' and (term == 'until_completion' or days_left &gt; 30)"
                  decoration-warning="state == 'active' and term != 'until_completion' and days_left &lt;= 30"
                  decoration-danger="state == 'expired'"
                  decoration-muted="state == 'terminated'">
                <header>
                    <!-- The webclient strips default_* keys when a button
                         launches another action, so the section is passed on
                         explicitly here (overridden to 'sow' further down). -->
                    <button name="%(action_contracts_report_wizard)d"
                            string="Export Excel"
                            type="action"
                            context="{'default_contract_type': 'msa'}"
                            class="btn-primary"
                            display="always"/>
                </header>

                <field name="contract_type" column_invisible="1"/>
                <field name="client"/>
                <field name="billing_mode" optional="show"
                       column_invisible="context.get('default_contract_type') != 'msa'"/>
                <field name="poc" optional="show"/>
                <field name="created_by_id" widget="many2one_avatar_user" readonly="1"/>
                <field name="start_date" widget="contracts_date"/>
                <field name="end_date" widget="contracts_date"/>
                <!-- Fills the gap a contract with no end date leaves, and only
                     that: a fixed-term row would just repeat its own end date. -->
                <field name="term" string="Term" invisible="term != 'until_completion'"
                       column_invisible="context.get('default_contract_type') != 'msa'"
                       optional="show"/>
                <field name="extended_end_date" widget="contracts_date" optional="hide"/>
                <field name="annual_appraisal_due" widget="contracts_date" optional="hide"/>
                <!-- An MSA doing FTE carries the FTE terms agreed with the
                     client, each hire being billed on its own placement;
                     consulting is billed on each SOW by bill rate against
                     salary or cost, on a billing cycle from a start date.
                     Amounts are full figures. -->
                <field name="budget" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'msa'"/>
                <field name="guarantee_period" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'msa'"/>
                <field name="fte_fee_type" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'msa'"/>
                <field name="fte_fee_value" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'msa'"/>
                <field name="bill_rate" optional="show"
                       column_invisible="context.get('default_contract_type') != 'sow'"/>
                <field name="salary_cost" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'sow'"/>
                <field name="gross_profit_margin" optional="show"
                       column_invisible="context.get('default_contract_type') != 'sow'"/>
                <field name="billing_frequency" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'sow'"/>
                <field name="billing_start_date" widget="contracts_date" optional="hide"
                       column_invisible="context.get('default_contract_type') != 'sow'"/>
                <field name="days_left" string="Days Left"
                       invisible="term == 'until_completion'"/>
                <field name="attachment_count" string="Attachments" optional="show"/>
                <field name="child_contract_count" string="Linked"
                       column_invisible="context.get('default_contract_type') != 'msa'"
                       optional="hide"/>
                <field name="fte_placement_count" string="FTE Placements"
                       column_invisible="context.get('default_contract_type') != 'msa'"
                       optional="hide"/>
                <field name="termination_date" widget="contracts_date" optional="hide"/>
                <field name="reminder_sent_days" optional="hide"/>
                <field name="create_date" widget="contracts_datetime" string="Created On" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <!-- ── Form ───────────────────────────────────────────────────────── -->
    <record id="view_contracts_contract_form" model="ir.ui.view">
        <field name="name">contracts.contract.form</field>
        <field name="model">contracts.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <!-- One confirmation either way: the plain question when
                         nothing runs under the contract, otherwise the dialog
                         that names what does, which asks the same thing. -->
                    <button name="action_terminate"
                            string="Terminate"
                            type="object"
                            class="btn-danger"
                            confirm="Terminate this contract? It will be closed as of today."
                            invisible="state == 'terminated' or active_child_count"/>
                    <button name="action_terminate"
                            string="Terminate"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'terminated' or not active_child_count"/>
                    <button name="action_reset_to_active"
                            string="Reset to Active"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'terminated'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired,terminated"/>
                </header>
                <sheet>
                    <field name="contract_type" invisible="1"/>
                    <field name="active_child_count" invisible="1"/>
                    <field name="attachment_count" invisible="1"/>

                    <!-- Fills the empty space beside the title, and gives an
                         overarching contract a way through to what sits under it. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_child_contracts"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                invisible="contract_type != 'msa' or not id or billing_mode not in ('consulting', 'both')">
                            <div class="o_stat_info">
                                <field name="child_contract_count" class="o_stat_value"/>
                                <span class="o_stat_text">Linked</span>
                            </div>
                        </button>
                        <button name="action_view_fte_placements"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user-plus"
                                invisible="contract_type != 'msa' or not id or billing_mode not in ('fte', 'both')">
                            <div class="o_stat_info">
                                <field name="fte_placement_count" class="o_stat_value"/>
                                <span class="o_stat_text">FTE Placements</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Terminated" bg_color="text-bg-danger"
                            invisible="state != 'terminated'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-warning"
                            invisible="state != 'expired'"/>

                    <div class="oe_title">
                        <label for="client" string="Client"/>
                        <h1>
                            <field name="client" placeholder="Client name..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contract Period" name="period">
                            <field name="start_date" widget="contracts_date"/>
                            <!-- Only an overarching contract can run until
                                 completion of service; one placed under it
                                 always has an end date. -->
                            <field name="term" widget="radio"
                                   invisible="contract_type != 'msa'"/>
                            <field name="end_date" widget="contracts_date"
                                   invisible="term == 'until_completion'"
                                   required="term != 'until_completion'"/>
                            <!-- Bare integers read poorly on their own, so the
                                 unit rides alongside the value. -->
                            <label for="days_left"
                                   invisible="state != 'active' or term == 'until_completion'"/>
                            <div class="d-flex align-items-baseline gap-1"
                                 invisible="state != 'active' or term == 'until_completion'">
                                <field name="days_left" class="oe_inline"/>
                                <span class="text-muted">days remaining</span>
                            </div>
                            <!-- The date is only asked for once the contract is
                                 said to be extended; answering No clears it.
                                 A contract with no end has nothing to extend.
                                 Extending an MSA extends the agreement: the
                                 SOWs under it can run on, and hires can still
                                 be made through it. -->
                            <field name="is_extended" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="term == 'until_completion'"/>
                            <!-- The term only clears these on save, so switching
                                 to it and back by mistake loses nothing; until
                                 then they are hidden rather than wiped. -->
                            <field name="extended_end_date" widget="contracts_date"
                                   placeholder="Set when the contract is extended"
                                   invisible="is_extended != 'yes' or term == 'until_completion'"
                                   required="is_extended == 'yes' and term != 'until_completion'"/>
                            <!-- Only worth showing once the two dates differ;
                                 until then it just repeats the end date. -->
                            <field name="effective_end_date" widget="contracts_date" readonly="1"
                                   invisible="not extended_end_date or term == 'until_completion'"/>
                            <field name="is_appraisal_due" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="contract_type != 'sow'"/>
                            <field name="annual_appraisal_due" widget="contracts_date" readonly="1"
                                   invisible="contract_type != 'sow' or is_appraisal_due != 'yes'"/>
                            <field name="termination_date" widget="contracts_date"
                                   invisible="state != 'terminated'"/>
                        </group>
                        <group string="Ownership" name="ownership">
                            <!-- One of three, Consulting to start with. A
                                 placed contract has no type of its own. -->
                            <field name="billing_mode" widget="radio"
                                   options="{'horizontal': true}"
                                   invisible="contract_type != 'msa'"
                                   required="contract_type == 'msa'"/>
                            <field name="poc"/>
                            <field name="created_by_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="create_date" widget="contracts_datetime" string="Created On" readonly="1"/>
                            <!-- Only worth showing once a reminder has gone
                                 out; otherwise it is two empty rows. -->
                            <field name="reminder_sent_days" readonly="1"
                                   invisible="state != 'active' or not reminder_sent_days"/>
                            <field name="reminder_last_sent" widget="contracts_date" readonly="1"
                                   invisible="state != 'active' or not reminder_sent_days"/>
                        </group>
                    </group>

                    <!-- An MSA doing FTE carries the FTE terms agreed with the
                         client; each hire under it is billed on its own FTE
                         placement. Consulting is billed on each SOW, which is
                         always consulting, so always billed. -->
                    <group string="FTE Terms" name="fte_terms"
                           invisible="contract_type != 'msa' or billing_mode not in ('fte', 'both')">
                        <group name="fte_amounts">
                            <field name="budget"/>
                            <field name="guarantee_period"/>
                        </group>
                        <group name="fte_fee">
                            <field name="fte_fee_type" widget="radio"
                                   options="{'horizontal': true}"/>
                            <field name="fte_fee_value" invisible="not fte_fee_type"/>
                        </group>
                    </group>
                    <group string="Billing" name="billing" invisible="contract_type != 'sow'">
                        <group name="billing_terms">
                            <field name="bill_rate"/>
                            <field name="salary_cost"/>
                            <field name="gross_profit_margin"
                                   decoration-danger="gross_profit_margin &lt; 0"/>
                            <field name="billing_frequency" widget="radio"
                                   options="{'horizontal': true}"/>
                        </group>
                        <group name="billing_dates">
                            <field name="billing_start_date" widget="contracts_date"/>
                        </group>
                    </group>
                    <div class="text-muted mb-3"
                         invisible="contract_type != 'msa' or billing_mode not in ('consulting', 'both')">
                        <i class="fa fa-info-circle" title="Information"/>
                        Consulting is billed on each Statement of Work placed
                        under this contract.
                    </div>

                    <notebook>
                        <page string="Remarks" name="remarks">
                            <field name="remarks" nolabel="1"
                                   placeholder="Notes about this contract - extensions, appraisals, anything worth recording..."/>
                        </page>
                        <page string="Linked Contracts" name="children"
                              invisible="contract_type != 'msa' or billing_mode not in ('consulting', 'both')">
                            <field name="child_contract_ids" readonly="1" nolabel="1">
                                <list decoration-danger="state == 'terminated'"
                                      decoration-muted="state == 'expired'">
                                    <field name="candidate"/>
                                    <field name="role"/>
                                    <field name="poc" optional="hide"/>
                                    <field name="start_date" widget="contracts_date"/>
                                    <field name="end_date" widget="contracts_date"/>
                                    <field name="bill_rate" optional="show"/>
                                    <field name="gross_profit_margin" optional="hide"/>
                                    <field name="days_left"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'expired'"
                                           decoration-danger="state == 'terminated'"/>
                                </list>
                                <!-- Without an inline form the dialog would fall
                                     back to the overarching contract's form,
                                     which carries no candidate or role. -->
                                <form string="Linked Contract">
                                    <sheet>
                                        <div class="oe_title">
                                            <h1><field name="candidate" readonly="1"/></h1>
                                            <h3 class="text-muted"><field name="role" readonly="1"/></h3>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="start_date" widget="contracts_date" readonly="1"/>
                                                <field name="end_date" widget="contracts_date" readonly="1"/>
                                                <field name="days_left" invisible="state != 'active'"/>
                                            </group>
                                            <group>
                                                <field name="poc" readonly="1"/>
                                                <field name="created_by_id"
                                                       widget="many2one_avatar_user" readonly="1"/>
                                                <field name="state" readonly="1"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <div class="text-muted mt-2"
                                 invisible="child_contract_count">
                                <i class="fa fa-info-circle" title="Information"/>
                                Nothing has been placed under this contract yet.
                            </div>
                        </page>
                        <!-- Read here, recorded under FTE Placements or from the
                             button above, which opens them for this MSA. -->
                        <page string="FTE Placements" name="fte_placements"
                              invisible="contract_type != 'msa' or billing_mode not in ('fte', 'both')">
                            <field name="fte_placement_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="candidate"/>
                                    <field name="date_of_joining" widget="contracts_date"/>
                                    <field name="skillset" optional="show"/>
                                    <field name="offered_ctc" optional="show"/>
                                    <field name="fee_type"/>
                                    <field name="fee_value"/>
                                    <field name="billing_date" widget="contracts_date" optional="show"/>
                                    <field name="guarantee_end_date" widget="contracts_date" optional="hide"/>
                                </list>
                            </field>
                            <div class="text-muted mt-2"
                                 invisible="fte_placement_count">
                                <i class="fa fa-info-circle" title="Information"/>
                                No candidate has been hired through this contract yet.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────── -->
    <record id="view_contracts_contract_search" model="ir.ui.view">
        <field name="name">contracts.contract.search</field>
        <field name="model">contracts.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="client"/>
                <field name="billing_mode"/>
                <field name="poc"/>
                <field name="created_by_id"/>

                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="filter_terminated" string="Terminated"
                        domain="[('state', '=', 'terminated')]"/>
                <separator/>
                <filter name="filter_expiring_45" string="Expiring in 45 Days"
                        domain="[('state', '=', 'active'), ('days_left', '&lt;=', 45)]"/>
                <filter name="filter_expiring_30" string="Expiring in 30 Days"
                        domain="[('state', '=', 'active'), ('days_left', '&lt;=', 30)]"/>
                <!-- Inside the reminder window set in the settings but never
                     mailed about: either the cron has not run yet, or it
                     failed on this record. -->
                <filter name="filter_reminder_pending" string="No Reminder Sent"
                        domain="[('reminder_pending', '=', True)]"/>
                <filter name="filter_my_contracts" string="My Contracts"
                        domain="[('created_by_id', '=', uid)]"/>
                <filter name="filter_until_completion" string="Until Completion of Service"
                        domain="[('term', '=', 'until_completion')]"/>
                <separator/>
                <filter name="filter_fte" string="FTE"
                        domain="[('billing_mode', 'in', ('fte', 'both'))]"/>
                <filter name="filter_consulting" string="Consulting"
                        domain="[('billing_mode', 'in', ('consulting', 'both'))]"/>
                <separator/>
                <filter name="filter_start_date" string="Start Date" date="start_date"/>
                <filter name="filter_end_date" string="End Date" date="end_date"/>
                <filter name="filter_extended_end_date" string="Extended End Date"
                        date="extended_end_date"/>

                <group>
                    <filter name="group_client" string="Client" domain="[]" context="{'group_by': 'client'}"/>
                    <filter name="group_type" string="Contract Type" domain="[]" context="{'group_by': 'billing_mode'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_created_by" string="Created By" domain="[]" context="{'group_by': 'created_by_id'}"/>
                    <filter name="group_end_date" string="End Date" domain="[]" context="{'group_by': 'end_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Second section: a contract placed under another one. Adds the
         parent link, the person and the role, and takes its client from
         the contract above it.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_contracts_placed_list" model="ir.ui.view">
        <field name="name">contracts.contract.placed.list</field>
        <field name="model">contracts.contract</field>
        <field name="inherit_id" ref="view_contracts_contract_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="client" position="after">
                <field name="candidate"/>
                <field name="role"/>
                <field name="parent_contract_id" optional="hide"
                       context="{'contracts_show_period': True}"/>
            </field>

            <xpath expr="//header/button" position="attributes">
                <attribute name="context">{'default_contract_type': 'sow'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_contracts_placed_form" model="ir.ui.view">
        <field name="name">contracts.contract.placed.form</field>
        <field name="model">contracts.contract</field>
        <field name="inherit_id" ref="view_contracts_contract_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- The client is owned by the contract above, so it is shown but
                 not editable here. -->
            <xpath expr="//div[hasclass('oe_title')]/h1/field[@name='client']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="placeholder">Taken from the parent contract</attribute>
            </xpath>

            <!-- The candidate and the role identify the placement as much as
                 the client does, so they stay in the title. Side by side rather
                 than stacked: three headings in a column left the whole right
                 half of the sheet empty and pushed the fields below the fold. -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="d-flex flex-wrap column-gap-5 row-gap-2 mt-2">
                    <div>
                        <label for="candidate" string="Candidate" class="text-muted"/>
                        <h3 class="mb-0">
                            <field name="candidate" placeholder="Person placed..."/>
                        </h3>
                    </div>
                    <div>
                        <label for="role" string="Role" class="text-muted"/>
                        <h3 class="mb-0">
                            <field name="role" placeholder="Role covered..."/>
                        </h3>
                    </div>
                </div>
            </xpath>

            <!-- A group of its own for the parent contract left an empty column
                 beside it; it belongs with the rest of the record's context. -->
            <xpath expr="//group[@name='ownership']" position="attributes">
                <attribute name="string">Placement &amp; Ownership</attribute>
            </xpath>
            <xpath expr="//group[@name='ownership']/field[@name='poc']" position="before">
                <!-- One client can hold several of these over the years, so
                     each is offered with its period to tell them apart. -->
                <field name="parent_contract_id"
                       options="{'no_create': True}"
                       context="{'contracts_show_period': True}"
                       required="1"/>
            </xpath>
            <!-- The POC, like the client, is the contract above's. -->
            <xpath expr="//group[@name='ownership']/field[@name='poc']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="placeholder">Taken from the parent contract</attribute>
            </xpath>

            <!-- A client giving both kinds of business can hire the consultant
                 placed here: the SOW is terminated and the candidate recorded
                 as an FTE placement under the same MSA. -->
            <xpath expr="//header/button[@name='action_reset_to_active']" position="before">
                <field name="parent_billing_mode" invisible="1"/>
                <button name="action_convert_to_fte"
                        string="Convert to FTE"
                        type="object"
                        class="btn-primary"
                        invisible="state == 'terminated' or parent_billing_mode != 'both'"/>
            </xpath>

            <!-- The linked-contracts button and tab are for the contract above;
                 down here the useful jump is back up to it - and, once the
                 candidate has been hired, across to the FTE placement. -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <field name="converted_placement_ids" invisible="1"/>
                <button name="action_view_converted_placement"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-user-plus"
                        invisible="not converted_placement_ids">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Converted</span>
                        <span class="o_stat_text">to FTE</span>
                    </div>
                </button>
                <button name="action_open_parent_contract"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-level-up"
                        invisible="not parent_contract_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Parent</span>
                        <span class="o_stat_text">Contract</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_contracts_placed_search" model="ir.ui.view">
        <field name="name">contracts.contract.placed.search</field>
        <field name="model">contracts.contract</field>
        <field name="inherit_id" ref="view_contracts_contract_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="client" position="after">
                <field name="candidate"/>
                <field name="role"/>
                <field name="parent_contract_id"/>
            </field>
            <!-- A placed contract always has an end date, no type, and is
                 always consulting. -->
            <filter name="filter_until_completion" position="replace"/>
            <filter name="filter_fte" position="replace"/>
            <filter name="filter_consulting" position="replace"/>
            <field name="billing_mode" position="replace"/>
            <filter name="group_type" position="replace"/>
            <filter name="group_client" position="after">
                <filter name="group_role" string="Role" domain="[]" context="{'group_by': 'role'}"/>
                <filter name="group_parent" string="Parent Contract" domain="[]"
                        context="{'group_by': 'parent_contract_id'}"/>
            </filter>
            <filter name="group_created_by" position="after">
                <filter name="group_billing_frequency" string="Billing Frequency" domain="[]"
                        context="{'group_by': 'billing_frequency'}"/>
            </filter>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Window actions. The action name is the screen title.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="action_contracts_msa" model="ir.actions.act_window">
        <field name="name">Master Service Agreement</field>
        <field name="res_model">contracts.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_type', '=', 'msa')]</field>
        <field name="context">{'default_contract_type': 'msa'}</field>
        <field name="search_view_id" ref="view_contracts_contract_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
