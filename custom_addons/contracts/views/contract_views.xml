<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         Base views. These carry the fields common to every contract and are
         used as-is by the first section; the second section derives from
         them below, adding the fields that only apply to a placement.
         ══════════════════════════════════════════════════════════════════ -->

    <!-- ── List ───────────────────────────────────────────────────────── -->
    <record id="view_contracts_contract_list" model="ir.ui.view">
        <field name="name">contracts.contract.list</field>
        <field name="model">contracts.contract</field>
        <field name="arch" type="xml">
            <list string="Contracts"
                  decoration-success="state == 'active' and days_left &gt; 30"
                  decoration-warning="state == 'active' and days_left &lt;= 30"
                  decoration-danger="state == 'expired'"
                  decoration-muted="state == 'terminated'">
                <header>
                    <!-- The webclient strips default_* keys when a button
                         launches another action, so the section is passed on
                         explicitly here (overridden to 'sow' further down). -->
                    <button name="%(action_contracts_report_wizard)d"
                            string="Export Excel"
                            type="action"
                            context="{'default_contract_type': 'msa'}"
                            class="btn-primary"
                            display="always"/>
                </header>

                <field name="contract_type" column_invisible="1"/>
                <field name="client"/>
                <field name="poc" optional="show"/>
                <field name="created_by_id" widget="many2one_avatar_user" readonly="1"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="days_left" string="Days Left"/>
                <field name="attachment_count" string="Attachments" optional="show"/>
                <field name="child_contract_count" string="Linked"
                       column_invisible="context.get('default_contract_type') != 'msa'"
                       optional="hide"/>
                <field name="termination_date" optional="hide"/>
                <field name="reminder_sent_days" optional="hide"/>
                <field name="create_date" string="Created On" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'expired'"
                       decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <!-- ── Form ───────────────────────────────────────────────────────── -->
    <record id="view_contracts_contract_form" model="ir.ui.view">
        <field name="name">contracts.contract.form</field>
        <field name="model">contracts.contract</field>
        <field name="arch" type="xml">
            <form string="Contract">
                <header>
                    <button name="action_terminate"
                            string="Terminate"
                            type="object"
                            class="btn-danger"
                            confirm="Terminate this contract? It will be closed as of today."
                            invisible="state == 'terminated'"/>
                    <button name="action_reset_to_active"
                            string="Reset to Active"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'terminated'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,expired,terminated"/>
                </header>
                <sheet>
                    <field name="contract_type" invisible="1"/>
                    <field name="active_child_count" invisible="1"/>
                    <field name="attachment_count" invisible="1"/>

                    <!-- Fills the empty space beside the title, and gives an
                         overarching contract a way through to what sits under it. -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_child_contracts"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap"
                                invisible="contract_type != 'msa' or not id">
                            <div class="o_stat_info">
                                <field name="child_contract_count" class="o_stat_value"/>
                                <span class="o_stat_text">Linked</span>
                            </div>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Terminated" bg_color="text-bg-danger"
                            invisible="state != 'terminated'"/>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-warning"
                            invisible="state != 'expired'"/>

                    <div class="oe_title">
                        <label for="client" string="Client"/>
                        <h1>
                            <field name="client" placeholder="Client name..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Contract Period" name="period">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <!-- Bare integers read poorly on their own, so the
                                 unit rides alongside the value. -->
                            <label for="days_left" invisible="state != 'active'"/>
                            <div class="o_row" invisible="state != 'active'">
                                <field name="days_left" class="oe_inline"/>
                                <span class="text-muted">days remaining</span>
                            </div>
                            <field name="termination_date"
                                   invisible="state != 'terminated'"/>
                        </group>
                        <group string="Ownership" name="ownership">
                            <field name="poc"/>
                            <field name="created_by_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="create_date" string="Created On" readonly="1"/>
                            <!-- Only worth showing once a reminder has gone
                                 out; otherwise it is two empty rows. -->
                            <field name="reminder_sent_days" readonly="1"
                                   invisible="state != 'active' or not reminder_sent_days"/>
                            <field name="reminder_last_sent" readonly="1"
                                   invisible="state != 'active' or not reminder_sent_days"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Documents" name="documents">
                            <field name="attachment_ids"
                                   widget="many2many_binary"
                                   nolabel="1"/>
                            <div class="text-muted mt-2">
                                <i class="fa fa-info-circle" title="Information"/>
                                At least one document is required before the contract can be saved.
                                Uploaded files also appear in the attachments box below.
                            </div>
                        </page>
                        <page string="Linked Contracts" name="children"
                              invisible="contract_type != 'msa'">
                            <field name="child_contract_ids" readonly="1" nolabel="1">
                                <list decoration-danger="state == 'terminated'"
                                      decoration-muted="state == 'expired'">
                                    <field name="candidate"/>
                                    <field name="role"/>
                                    <field name="poc" optional="hide"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="days_left"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'active'"
                                           decoration-warning="state == 'expired'"
                                           decoration-danger="state == 'terminated'"/>
                                </list>
                                <!-- Without an inline form the dialog would fall
                                     back to the overarching contract's form,
                                     which carries no candidate or role. -->
                                <form string="Linked Contract">
                                    <sheet>
                                        <div class="oe_title">
                                            <h1><field name="candidate" readonly="1"/></h1>
                                            <h3 class="text-muted"><field name="role" readonly="1"/></h3>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="start_date" readonly="1"/>
                                                <field name="end_date" readonly="1"/>
                                                <field name="days_left" invisible="state != 'active'"/>
                                            </group>
                                            <group>
                                                <field name="poc" readonly="1"/>
                                                <field name="created_by_id"
                                                       widget="many2one_avatar_user" readonly="1"/>
                                                <field name="state" readonly="1"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                            <div class="text-muted mt-2"
                                 invisible="child_contract_count">
                                <i class="fa fa-info-circle" title="Information"/>
                                Nothing has been placed under this contract yet.
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────── -->
    <record id="view_contracts_contract_search" model="ir.ui.view">
        <field name="name">contracts.contract.search</field>
        <field name="model">contracts.contract</field>
        <field name="arch" type="xml">
            <search string="Search Contracts">
                <field name="client"/>
                <field name="poc"/>
                <field name="created_by_id"/>

                <filter name="filter_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="filter_expired" string="Expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter name="filter_terminated" string="Terminated"
                        domain="[('state', '=', 'terminated')]"/>
                <separator/>
                <filter name="filter_expiring_45" string="Expiring in 45 Days"
                        domain="[('state', '=', 'active'), ('days_left', '&lt;=', 45)]"/>
                <filter name="filter_expiring_30" string="Expiring in 30 Days"
                        domain="[('state', '=', 'active'), ('days_left', '&lt;=', 30)]"/>
                <!-- Inside the reminder window but never mailed about: either
                     the cron has not run yet, or it failed on this record. -->
                <filter name="filter_reminder_pending" string="No Reminder Sent"
                        domain="[('state', '=', 'active'), ('days_left', '&lt;=', 45), ('reminder_sent_days', '=', 0)]"/>
                <filter name="filter_my_contracts" string="My Contracts"
                        domain="[('created_by_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_start_date" string="Start Date" date="start_date"/>
                <filter name="filter_end_date" string="End Date" date="end_date"/>

                <group>
                    <filter name="group_client" string="Client" domain="[]" context="{'group_by': 'client'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_created_by" string="Created By" domain="[]" context="{'group_by': 'created_by_id'}"/>
                    <filter name="group_end_date" string="End Date" domain="[]" context="{'group_by': 'end_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Second section: a contract placed under another one. Adds the
         parent link, the person and the role, and takes its client from
         the contract above it.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="view_contracts_placed_list" model="ir.ui.view">
        <field name="name">contracts.contract.placed.list</field>
        <field name="model">contracts.contract</field>
        <field name="inherit_id" ref="view_contracts_contract_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="client" position="after">
                <field name="candidate"/>
                <field name="role"/>
                <field name="parent_contract_id" optional="hide"/>
            </field>

            <xpath expr="//header/button" position="attributes">
                <attribute name="context">{'default_contract_type': 'sow'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_contracts_placed_form" model="ir.ui.view">
        <field name="name">contracts.contract.placed.form</field>
        <field name="model">contracts.contract</field>
        <field name="inherit_id" ref="view_contracts_contract_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <!-- The client is owned by the contract above, so it is shown but
                 not editable here. -->
            <xpath expr="//div[hasclass('oe_title')]/h1/field[@name='client']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="placeholder">Taken from the parent contract</attribute>
            </xpath>

            <!-- The candidate and the role identify the placement as much as
                 the client does, so they stay in the title. Side by side rather
                 than stacked: three headings in a column left the whole right
                 half of the sheet empty and pushed the fields below the fold. -->
            <xpath expr="//div[hasclass('oe_title')]" position="inside">
                <div class="d-flex flex-wrap column-gap-5 row-gap-2 mt-2">
                    <div>
                        <label for="candidate" string="Candidate" class="text-muted"/>
                        <h3 class="mb-0">
                            <field name="candidate" placeholder="Person placed..."/>
                        </h3>
                    </div>
                    <div>
                        <label for="role" string="Role" class="text-muted"/>
                        <h3 class="mb-0">
                            <field name="role" placeholder="Role covered..."/>
                        </h3>
                    </div>
                </div>
            </xpath>

            <!-- A group of its own for the parent contract left an empty column
                 beside it; it belongs with the rest of the record's context. -->
            <xpath expr="//group[@name='ownership']" position="attributes">
                <attribute name="string">Placement &amp; Ownership</attribute>
            </xpath>
            <xpath expr="//group[@name='ownership']/field[@name='poc']" position="before">
                <field name="parent_contract_id"
                       options="{'no_create': True}"
                       required="1"/>
            </xpath>

            <!-- The linked-contracts button and tab are for the contract above;
                 down here the useful jump is back up to it. -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_parent_contract"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-level-up"
                        invisible="not parent_contract_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Parent</span>
                        <span class="o_stat_text">Contract</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_contracts_placed_search" model="ir.ui.view">
        <field name="name">contracts.contract.placed.search</field>
        <field name="model">contracts.contract</field>
        <field name="inherit_id" ref="view_contracts_contract_search"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <field name="client" position="after">
                <field name="candidate"/>
                <field name="role"/>
                <field name="parent_contract_id"/>
            </field>
            <filter name="group_client" position="after">
                <filter name="group_role" string="Role" domain="[]" context="{'group_by': 'role'}"/>
                <filter name="group_parent" string="Parent Contract" domain="[]"
                        context="{'group_by': 'parent_contract_id'}"/>
            </filter>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         Window actions. The action name is the screen title.
         ══════════════════════════════════════════════════════════════════ -->

    <record id="action_contracts_msa" model="ir.actions.act_window">
        <field name="name">Master Service Agreement</field>
        <field name="res_model">contracts.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_type', '=', 'msa')]</field>
        <field name="context">{'default_contract_type': 'msa'}</field>
        <field name="search_view_id" ref="view_contracts_contract_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'list', 'view_id': ref('view_contracts_contract_list')}),
            (0, 0, {'sequence': 20, 'view_mode': 'form', 'view_id': ref('view_contracts_contract_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first contract</p>
            <p>
                Track a contract from Active through to Expired or Terminated,
                with the signed documents attached.
            </p>
        </field>
    </record>

    <record id="action_contracts_sow" model="ir.actions.act_window">
        <field name="name">Statement of Work</field>
        <field name="res_model">contracts.contract</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('contract_type', '=', 'sow')]</field>
        <field name="context">{'default_contract_type': 'sow'}</field>
        <field name="search_view_id" ref="view_contracts_placed_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'list', 'view_id': ref('view_contracts_placed_list')}),
            (0, 0, {'sequence': 20, 'view_mode': 'form', 'view_id': ref('view_contracts_placed_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record your first contract</p>
            <p>
                Place a candidate with a client under an existing contract,
                with the signed documents attached.
            </p>
        </field>
    </record>

</odoo>
