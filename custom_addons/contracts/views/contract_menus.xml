<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root -->
    <menuitem
        id="menu_contracts_root"
        name="Contracts"
        web_icon="contracts,static/description/icon.png"
        sequence="90"
        groups="group_contracts_user"/>

    <menuitem
        id="menu_contracts_msa"
        name="MSA"
        parent="menu_contracts_root"
        action="action_contracts_msa"
        sequence="10"/>

    <menuitem
        id="menu_contracts_sow"
        name="SOW"
        parent="menu_contracts_root"
        action="action_contracts_sow"
        sequence="20"/>

    <!-- Contracts administrators maintain the master lists. Settings stays
         with system admins: res.config.settings.execute() refuses anyone
         else, so a visible entry would lead nowhere but an access error. -->
    <menuitem
        id="menu_contracts_config"
        name="Configuration"
        parent="menu_contracts_root"
        sequence="100"
        groups="group_contracts_manager"/>

    <menuitem
        id="menu_contracts_config_settings"
        name="Settings"
        parent="menu_contracts_config"
        action="action_contracts_config_settings"
        sequence="10"
        groups="base.group_system"/>

    <menuitem
        id="menu_contracts_config_types"
        name="Contract Types"
        parent="menu_contracts_config"
        action="action_contracts_type"
        sequence="20"
        groups="group_contracts_manager"/>

</odoo>
