<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Seed values only. These are edited under Contracts > Configuration >
         Settings, which writes straight back to these parameters; noupdate
         keeps those edits from being reverted by an upgrade. -->
    <data noupdate="1">

        <!-- Days before the end date an expiry reminder goes out. -->
        <record id="reminder_days_param" model="ir.config_parameter">
            <field name="key">contracts.reminder_days</field>
            <field name="value">45,30,7</field>
        </record>

    </data>
</odoo>
