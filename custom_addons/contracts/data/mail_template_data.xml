<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No noupdate here, unlike the cron and the system parameters: the
         wording carries no user-owned state, so reworded copy should land on
         the next upgrade.

         The expiry reminder has this layout: a coloured header naming what happened,
         a short sentence saying what to do about it, the contract's details,
         a button straight into the record, and a footer saying why the reader
         got the email. Recipients are supplied per send, from the users picked
         under Contracts > Configuration > Settings; email_from is left out so
         it falls back to the company address the outgoing mail server expects.
         The link comes in through the context as contracts_url. -->
    <data>

        <!-- ── Expiry reminder ───────────────────────────────────────── -->
        <!-- Everything beyond the record itself - formatted dates, the next
             reminder, the SOWs under an MSA - comes in as ctx['contracts_reminder'],
             built by contracts.contract._get_expiry_reminder_values. Tables
             and inline styles only, so it holds up in Outlook and Gmail. -->
        <record id="mail_template_contract_expiry_reminder" model="mail.template">
            <field name="name">Contracts: Expiry Reminder</field>
            <field name="model_id" ref="model_contracts_contract"/>
            <!-- Days left, not the milestone: after downtime a contract can be
                 caught up on with fewer days left than the milestone it hit. -->
            <field name="subject">{{ 'Action needed: ' if object.days_left &lt;= 7 else '' }}{{ 'SOW' if object.contract_type == 'sow' else 'MSA' }} ends {{ 'today' if object.days_left == 0 else ('tomorrow' if object.days_left == 1 else 'in %s days' % object.days_left) }} - {{ object.display_name }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent by the nightly scheduled action when an MSA or SOW reaches one of the reminder milestones before its end date.</field>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333;">
    <t t-set="is_sow" t-value="object.contract_type == 'sow'"/>
    <t t-set="r" t-value="ctx.get('contracts_reminder') or {}"/>
    <t t-set="days" t-value="object.days_left"/>
    <t t-set="accent" t-value="r.get('accent') or '#2471A3'"/>

    <!-- Header -->
    <div t-attf-style="border-left: 4px solid {{ accent }}; padding: 2px 0 2px 14px; margin: 0 0 20px 0;">
        <div t-attf-style="font-size: 11px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; color: {{ accent }};">
            <t t-if="r.get('urgent')">Expiry Reminder - Action Needed</t>
            <t t-else="">Expiry Reminder</t>
        </div>
        <div style="font-size: 20px; font-weight: bold; margin-top: 2px;" t-out="object.display_name or ''"/>
        <div style="font-size: 13px; color: #888888;">
            <t t-if="is_sow">Statement of Work</t><t t-else="">Master Service Agreement</t>
        </div>
    </div>

    <!-- Countdown -->
    <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: separate; border: 1px solid #E5E5E5; border-radius: 6px; margin: 0 0 24px 0; font-family: Arial, Helvetica, sans-serif; color: #333333;">
        <tr>
            <td width="110" align="center" valign="middle" t-attf-style="background-color: {{ accent }}; color: #FFFFFF; border-radius: 5px 0 0 5px; padding: 14px 8px;">
                <t t-if="days == 0">
                    <div style="font-size: 22px; font-weight: bold; line-height: 1.1;">TODAY</div>
                    <div style="font-size: 11px; letter-spacing: 1px; text-transform: uppercase;">last day</div>
                </t>
                <t t-else="">
                    <div style="font-size: 36px; font-weight: bold; line-height: 1.1;" t-out="days"/>
                    <div style="font-size: 11px; letter-spacing: 1px; text-transform: uppercase;">
                        <t t-if="days == 1">day left</t><t t-else="">days left</t>
                    </div>
                </t>
            </td>
            <td valign="middle" style="padding: 12px 18px;">
                <div style="font-size: 12px; color: #888888; text-transform: uppercase; letter-spacing: 1px;">Ends on</div>
                <div style="font-size: 17px; font-weight: bold;" t-out="r.get('ends_on') or format_date(object.effective_end_date)"/>
                <div style="font-size: 13px; color: #888888; margin-top: 4px;">
                    Running since <t t-out="r.get('started_on') or format_date(object.start_date)"/>
                    <t t-if="r.get('original_end')"> - already extended once, from <t t-out="r['original_end']"/></t>
                </div>
            </td>
        </tr>
    </table>

    <!-- Details, in four groups. A row only appears when it has a value, so
         an MSA without billing terms yet does not show a block of blanks. -->
    <t t-set="label_td" t-value="'padding: 7px 16px 7px 0; border-bottom: 1px solid #EEEEEE; color: #888888; width: 38%; vertical-align: top;'"/>
    <t t-set="value_td" t-value="'padding: 7px 0; border-bottom: 1px solid #EEEEEE; vertical-align: top;'"/>
    <t t-set="group_td" t-value="'padding: 18px 0 6px 0; border-bottom: 2px solid #DDDDDD; color: #555555; font-size: 12px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase;'"/>
    <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 0 0 24px 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333;">
        <!-- Contract -->
        <tr><td colspan="2" t-att-style="group_td + ' padding-top: 0;'">Contract</td></tr>
        <tr>
            <td t-att-style="label_td">Client</td>
            <td t-att-style="value_td" t-out="object.client or ''"/>
        </tr>
        <tr t-if="not is_sow">
            <td t-att-style="label_td">Contract Type</td>
            <td t-att-style="value_td" t-out="r.get('contract_type') or 'Not set'"/>
        </tr>
        <tr t-if="not is_sow and object.child_contract_ids">
            <td t-att-style="label_td">SOWs Under It</td>
            <td t-att-style="value_td">
                <t t-out="len(r.get('children') or [])"/> active
                <span style="color: #888888;">of <t t-out="len(object.child_contract_ids)"/> in total</span>
            </td>
        </tr>
        <tr t-if="is_sow">
            <td t-att-style="label_td">Candidate</td>
            <td t-att-style="value_td" t-out="object.candidate or ''"/>
        </tr>
        <tr t-if="is_sow">
            <td t-att-style="label_td">Role</td>
            <td t-att-style="value_td" t-out="object.role or ''"/>
        </tr>
        <tr t-if="is_sow">
            <td t-att-style="label_td">Under MSA</td>
            <td t-att-style="value_td">
                <t t-out="object.parent_contract_id.client or ''"/>
                <span style="color: #888888;">
                    <t t-if="r.get('parent_ends_on')">- runs until <t t-out="r['parent_ends_on']"/></t>
                    <t t-elif="object.parent_contract_id.term == 'until_completion'">- runs until completion of service</t>
                </span>
            </td>
        </tr>
        <tr>
            <td t-att-style="label_td">Contract POC</td>
            <td t-att-style="value_td" t-out="object.poc or ''"/>
        </tr>

        <!-- Dates -->
        <tr><td colspan="2" t-att-style="group_td">Dates</td></tr>
        <tr>
            <td t-att-style="label_td">Start Date</td>
            <td t-att-style="value_td" t-out="r.get('started_on') or format_date(object.start_date)"/>
        </tr>
        <tr>
            <td t-att-style="label_td">End Date</td>
            <td t-att-style="value_td">
                <t t-out="r.get('end_date') or format_date(object.end_date)"/>
                <span t-if="r.get('extended_end')" style="color: #888888;">(original)</span>
            </td>
        </tr>
        <tr t-if="r.get('extended_end')">
            <td t-att-style="label_td">Extended End Date</td>
            <td t-att-style="value_td"><strong t-out="r['extended_end']"/></td>
        </tr>
        <tr t-if="is_sow and r.get('appraisal_due')">
            <td t-att-style="label_td">Annual Appraisal Due</td>
            <td t-att-style="value_td" t-out="r['appraisal_due']"/>
        </tr>

        <!-- Billing -->
        <t t-if="r.get('budget') or r.get('guarantee_period') or r.get('fte_fee') or r.get('bill_rate') or r.get('salary_cost') or r.get('billing_frequency') or r.get('billing_start')">
            <tr><td colspan="2" t-att-style="group_td">Billing</td></tr>
            <tr t-if="r.get('budget')">
                <td t-att-style="label_td">Budget</td>
                <td t-att-style="value_td" t-out="r['budget']"/>
            </tr>
            <tr t-if="r.get('guarantee_period')">
                <td t-att-style="label_td">Guarantee Period</td>
                <td t-att-style="value_td" t-out="r['guarantee_period']"/>
            </tr>
            <tr t-if="r.get('fte_fee')">
                <td t-att-style="label_td">Standard FTE Fee</td>
                <td t-att-style="value_td" t-out="r['fte_fee']"/>
            </tr>
            <tr t-if="r.get('bill_rate')">
                <td t-att-style="label_td">Bill Rate</td>
                <td t-att-style="value_td" t-out="r['bill_rate']"/>
            </tr>
            <tr t-if="r.get('salary_cost')">
                <td t-att-style="label_td">Salary/Cost</td>
                <td t-att-style="value_td" t-out="r['salary_cost']"/>
            </tr>
            <tr t-if="r.get('gross_profit_margin')">
                <td t-att-style="label_td">Gross Profit Margin</td>
                <td t-att-style="value_td" t-out="r['gross_profit_margin']"/>
            </tr>
            <tr t-if="r.get('billing_frequency')">
                <td t-att-style="label_td">Frequency</td>
                <td t-att-style="value_td" t-out="r['billing_frequency']"/>
            </tr>
            <tr t-if="r.get('billing_start')">
                <td t-att-style="label_td">Billing Start Date</td>
                <td t-att-style="value_td" t-out="r['billing_start']"/>
            </tr>
        </t>

        <!-- Record -->
        <tr><td colspan="2" t-att-style="group_td">Record</td></tr>
        <tr t-if="object.created_by_id">
            <td t-att-style="label_td">Created By</td>
            <td t-att-style="value_td" t-out="object.created_by_id.name"/>
        </tr>
        <tr t-if="r.get('created_on')">
            <td t-att-style="label_td">Created On</td>
            <td t-att-style="value_td" t-out="r['created_on']"/>
        </tr>
        <tr>
            <td t-att-style="label_td">Documents</td>
            <td t-att-style="value_td">
                <t t-out="r.get('documents', 0)"/> <t t-if="r.get('documents') == 1">file</t><t t-else="">files</t> attached
            </td>
        </tr>
        <tr t-if="object.remarks">
            <td t-att-style="label_td">Remarks</td>
            <td t-att-style="value_td + ' white-space: pre-line;'" t-out="object.remarks"/>
        </tr>
    </table>

    <!-- SOWs that end with this MSA -->
    <t t-if="not is_sow and r.get('children')">
        <div style="font-size: 15px; font-weight: bold; margin: 0 0 4px 0;">
            Active SOWs under this MSA (<t t-out="len(r['children'])"/>)
        </div>
        <div style="font-size: 13px; color: #888888; margin: 0 0 8px 0;">
            None of them can run past the end date of this MSA.
        </div>
        <table width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 0 0 24px 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #333333;">
            <tr>
                <th style="padding: 7px 16px 7px 0; border-bottom: 2px solid #DDDDDD; color: #888888; font-size: 12px; text-align: left; text-transform: uppercase;">Candidate</th>
                <th style="padding: 7px 16px 7px 0; border-bottom: 2px solid #DDDDDD; color: #888888; font-size: 12px; text-align: left; text-transform: uppercase;">Role</th>
                <th style="padding: 7px 0; border-bottom: 2px solid #DDDDDD; color: #888888; font-size: 12px; text-align: left; text-transform: uppercase;">Ends</th>
            </tr>
            <tr t-foreach="r['children']" t-as="child">
                <td style="padding: 7px 16px 7px 0; border-bottom: 1px solid #EEEEEE;" t-out="child['candidate']"/>
                <td style="padding: 7px 16px 7px 0; border-bottom: 1px solid #EEEEEE;" t-out="child['role']"/>
                <td style="padding: 7px 0; border-bottom: 1px solid #EEEEEE;">
                    <t t-out="child['ends_on']"/>
                    <span t-if="child['ends_with_parent']" t-attf-style="color: {{ accent }}; font-size: 12px;"> (same day)</span>
                </td>
            </tr>
        </table>
    </t>

    <!-- Action -->
    <p style="margin: 0 0 24px 0;">
        <a t-att-href="ctx.get('contracts_url')"
           style="display: inline-block; background-color: #714B67; color: #FFFFFF; padding: 11px 22px; border-radius: 4px; text-decoration: none; font-weight: bold;">
            Open Contract
        </a>
    </p>

    <!-- Footer -->
    <div style="border-top: 1px solid #EEEEEE; padding-top: 12px; font-size: 12px; color: #999999;">
        <t t-if="r.get('next_days')">
            Next reminder: <t t-out="r['next_days']"/> <t t-if="r['next_days'] == 1">day</t><t t-else="">days</t>
            before the end, on <t t-out="r['next_on']"/> - unless the contract is extended or closed first.
        </t>
        <t t-else="">This is the last reminder before the contract ends.</t>
        <br/>
        You are receiving this because you are on the expiry reminder list in Contracts settings.
    </div>
</div>
            </field>
        </record>

        <!-- ── Change notification ───────────────────────────────────── -->
        <!-- One email per contract created, changed or deleted, sent as it
             happens. Everything arrives in ctx['contracts_change'], built by
             contracts.contract._send_change_notification; rendered before a
             deletion goes through, so a deleted contract is described from
             what it was and has no link to follow. -->
        <record id="mail_template_contract_change" model="mail.template">
            <field name="name">Contracts: Change Notification</field>
            <field name="model_id" ref="model_contracts_contract"/>
            <field name="subject">{{ (ctx.get('contracts_change') or {}).get('subject', 'Contract changed') }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="description">Sent to the change notification list as soon as an MSA or SOW is created, changed in its audit log, or deleted.</field>
            <field name="body_html" type="html">
<div style="margin: 0; padding: 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5; color: #333333;">
    <t t-set="c" t-value="ctx.get('contracts_change') or {}"/>
    <t t-set="accent" t-value="{'created': '#1E8449', 'deleted': '#922B21'}.get(c.get('event'), '#2471A3')"/>
    <t t-set="th" t-value="'padding: 6px 16px 6px 0; border-bottom: 2px solid #DDDDDD; color: #888888; font-size: 12px; font-weight: bold; text-align: left; text-transform: uppercase;'"/>
    <t t-set="td" t-value="'padding: 6px 16px 6px 0; border-bottom: 1px solid #EEEEEE; vertical-align: top;'"/>

    <!-- Header -->
    <div t-attf-style="border-left: 4px solid {{ accent }}; padding: 2px 0 2px 14px; margin: 0 0 20px 0;">
        <div t-attf-style="font-size: 11px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; color: {{ accent }};">
            <t t-out="c.get('kind')"/> <t t-out="c.get('label')"/>
        </div>
        <div style="font-size: 20px; font-weight: bold; margin-top: 2px;" t-out="c.get('name')"/>
        <div style="font-size: 13px; color: #888888;">by <t t-out="c.get('changed_by') or 'Someone'"/></div>
    </div>

    <!-- What changed -->
    <table t-if="c.get('changes')" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 0 0 20px 0; font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #333333;">
        <tr><th t-att-style="th + ' width: 34%;'">Field</th><th t-att-style="th + ' width: 33%;'">Before</th><th t-att-style="th">After</th></tr>
        <tr t-foreach="c['changes']" t-as="change">
            <td t-att-style="td" t-out="change['field']"/>
            <td t-att-style="td + ' color: #999999;'" t-out="change['old']"/>
            <td t-att-style="td"><strong t-out="change['new']"/></td>
        </tr>
    </table>

    <!-- What the contract is, when created or deleted -->
    <table t-if="c.get('details')" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse; margin: 0 0 20px 0; font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #333333;">
        <tr t-foreach="c['details']" t-as="line">
            <td t-att-style="td + ' color: #888888; width: 34%;'" t-out="line[0]"/>
            <td t-att-style="td" t-out="line[1]"/>
        </tr>
    </table>

    <!-- Button -->
    <div t-if="c.get('url')" style="margin: 0 0 24px 0;">
        <a t-att-href="c['url']"
           style="display: inline-block; padding: 10px 20px; background-color: #714B67; color: #FFFFFF; text-decoration: none; border-radius: 4px; font-weight: bold;">
            Open <t t-out="c.get('kind')"/>
        </a>
    </div>

    <div style="border-top: 1px solid #EEEEEE; padding-top: 12px; font-size: 12px; color: #999999;">
        You are receiving this because you are on the change notification list in Contracts settings.
        <t t-if="c.get('event') == 'deleted'">A deleted contract cannot be restored; if that was a mistake, it has to be created again.</t>
    </div>
</div>
            </field>
        </record>

    </data>
</odoo>
