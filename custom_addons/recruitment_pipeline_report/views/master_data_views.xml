<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- City Master Views -->
    <record id="view_recruitment_city_tree" model="ir.ui.view">
        <field name="name">recruitment.city.tree</field>
        <field name="model">recruitment.city</field>
        <field name="arch" type="xml">
            <list string="Cities" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_recruitment_city" model="ir.actions.act_window">
        <field name="name">Cities</field>
        <field name="res_model">recruitment.city</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first city!</p>
        </field>
    </record>

    <!-- Skill Master Views -->
    <record id="view_recruitment_skill_tree" model="ir.ui.view">
        <field name="name">recruitment.skill.tree</field>
        <field name="model">recruitment.skill</field>
        <field name="arch" type="xml">
            <list string="Skills" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_recruitment_skill" model="ir.actions.act_window">
        <field name="name">Skills</field>
        <field name="res_model">recruitment.skill</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first skill!</p>
        </field>
    </record>

    <!-- Menus under Recruitment -> Configuration -->
    <menuitem id="menu_recruitment_master_data"
              name="Master Data"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              sequence="100"/>

    <menuitem id="menu_recruitment_city"
              name="Cities"
              parent="menu_recruitment_master_data"
              action="action_recruitment_city"
              sequence="1"/>

    <menuitem id="menu_recruitment_skill"
              name="Skills"
              parent="menu_recruitment_master_data"
              action="action_recruitment_skill"
              sequence="2"/>

</odoo>
