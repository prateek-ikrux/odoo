<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Recruiter Group LIST -->
    <record id="view_recruiter_team_list" model="ir.ui.view">
        <field name="name">recruiter.team.list</field>
        <field name="model">recruiter.team</field>
        <field name="arch" type="xml">
            <list string="Recruiter Groups">
                <field name="name"/>
                <field name="team_lead_id"/>
                <field name="member_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Recruiter Group FORM -->
    <record id="view_recruiter_team_form" model="ir.ui.view">
        <field name="name">recruiter.team.form</field>
        <field name="model">recruiter.team</field>
        <field name="arch" type="xml">
            <form string="Recruiter Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. North Region Hiring Team"/>
                        </h1>
                    </div>
                    <group>
                        <field name="member_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="team_lead_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_recruiter_team" model="ir.actions.act_window">
        <field name="name">Recruiter Groups</field>
        <field name="res_model">recruiter.team</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first recruiter group!</p>
            <p>Group recruiters together so you can assign all of them to a job position in one click, with one member set as Team Lead.</p>
        </field>
    </record>

    <menuitem id="menu_recruiter_team"
              name="Recruiter Groups"
              parent="menu_recruitment_master_data"
              action="action_recruiter_team"
              sequence="3"/>

</odoo>
