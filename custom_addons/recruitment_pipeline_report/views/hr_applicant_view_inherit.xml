<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════
         FORM — custom fields merged into the "Details" tab
         Inherits: hr_recruitment.hr_applicant_view_form (id 655)

         KEY DECISIONS based on repo analysis + Odoo 19 docs:
         1. x_assessment_link_received appears TWICE in current repo:
            - once after department_id (top section) — REMOVED here
            - once inside Assessment group in tab — KEPT (correct place)
         2. Salary/Sourcing: use position="attributes" invisible="1"
            (safer than position="replace" which errors if element
            is missing in any inheriting view like the interviewer form)
         3. No separate "Candidate Details" tab is created. The hidden
            Applicant/Job, Salary Package, Sourcing, Interviewers and
            Tags groups/fields leave the standard "Details" tab mostly
            empty, so all candidate-detail groups are appended into
            that same tab (application_details) to use the space.
    ══════════════════════════════════════════════════════════ -->
    <record id="hr_applicant_form_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.applicant.form.inherit.pipeline</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <!-- Relabel department as Client and make readonly -->
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- Insert job-position readonly fields after department.
                 NOTE: x_assessment_link_received removed from here —
                 it belongs only in the Assessment group in the tab below. -->
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="x_req_id"               string="Req ID"              readonly="1"/>
                <field name="x_employment_type"      string="Employment Type"     readonly="1"/>
                <field name="x_poc_id"               string="POC"                 readonly="1"/>
                <field name="x_role_status"          string="Role Status"         readonly="1"/>
                <field name="x_sub_status"           string="Role Status Remarks"          readonly="1"/>
                <field name="x_min_experience"       string="Min Exp (Yrs)"       readonly="1"/>
                <field name="x_max_experience"       string="Max Exp (Yrs)"       readonly="1"/>
                <field name="x_job_location_ids"     invisible="1"/>
                <field name="x_client_portal_status" string="Client Portal Status"/>
            </xpath>

            <!-- LinkedIn profile field with custom logo button.
                 widget="url" removed so Odoo's built-in "Go to URL" link
                 icon no longer renders; the custom logo button below is
                 the only way to open the link. -->
            <xpath expr="//field[@name='linkedin_profile']" position="replace">
                <label for="linkedin_profile"/>
                <div class="o_row">
                    <field name="linkedin_profile" placeholder="e.g. https://www.linkedin.com/in/..."/>
                    <button name="action_open_linkedin" type="object" class="btn btn-sm btn-link" invisible="not linkedin_profile" title="Open LinkedIn">
                        <img src="/recruitment_pipeline_report/static/src/img/linkedin_logo.png" alt="LinkedIn Logo" style="height: 24px; object-fit: contain;"/>
                    </button>
                </div>
            </xpath>

            <!-- Rename Phone to Contact Number in the top section -->
            <xpath expr="//field[@name='partner_phone']" position="attributes">
                <attribute name="string">Contact Number</attribute>
            </xpath>

            <!-- Merge candidate-detail fields into the existing "Details" tab
                 (application_details) instead of adding a separate
                 "Candidate Details" tab. The Applicant/Job, Salary Package,
                 Sourcing, Interviewers and Tags areas above are hidden via
                 invisible="1", which leaves the Details tab mostly empty —
                 appending these groups here fills that space and avoids an
                 extra near-empty tab. -->
            <xpath expr="//page[@name='application_details']" position="inside">
                <group>
                    <group string="Personal">
                        <!-- source_id moved here from Sourcing section.
                             Always "iKrux Engineering" — readonly, value
                             enforced server-side in models/hr_applicant.py -->
                        <field name="source_id"                  string="Source" readonly="1"/>
                        <field name="x_skill_ids"                widget="many2many_tags" string="Skill" options="{'no_create_edit': True}"/>
                        <field name="x_total_experience"         string="Total Experience"/>
                        <field name="x_relevant_experience"      string="Relevant Experience"/>
                        <field name="x_current_organization"     string="Current Organization"/>
                        <field name="x_designation"              string="Designation"/>
                        <field name="x_education"                string="Education"/>
                    </group>
                    <group string="Location &amp; Availability">
                        <field name="x_current_location_id"      string="Current Location" options="{'no_create_edit': True}"/>
                        <field name="x_preferred_location_ids"   widget="many2many_tags" string="Preferred Location" domain="[('id', 'in', x_job_location_ids)]" options="{'no_create_edit': True}"/>
                        <field name="x_open_to_anywhere"         string="Open to Anywhere"/>
                        <field name="x_notice_period"            string="Notice Period"/>
                        <field name="x_lwd"
                               string="Last Working Date"
                               invisible="x_notice_period not in ('serving_notice', 'immediate_joiner')"/>
                    </group>
                </group>
                <group>
                    <group string="Compensation">
                        <field name="x_current_ctc_lpa"          string="Current CTC (LPA)"/>
                        <field name="x_expected_ctc_lpa"         string="Expected CTC (LPA)"/>
                        <field name="x_offer_in_hand_ids"        widget="many2many_tags" options="{'no_open': True}" string="Offer in Hand (LPA)"/>

                        <field name="x_budget_lpa_display"       string="Budget (LPA)"     invisible="x_budget_lpa_display == 0.0" readonly="1"/>
                        <field name="x_bill_rate_lpm_display"    string="Bill Rate (LPM)"  invisible="x_bill_rate_lpm_display == 0.0" readonly="1"/>
                    </group>
                    <group string="Additional Information">
                        <field name="x_reason_for_job_change" string="Reason for Job Change" colspan="2"/>
                        <field name="x_remarks"               string="Remarks"               colspan="2"/>
                    </group>
                </group>
            </xpath>

            <!-- ── Fill the empty half of the "Job" group ───────────────
                 The "Applicant" group (containing type_id) is hidden below,
                 leaving its sibling "Job" group alone in a 2-column row
                 with an empty second column. Adding the small "Assessment"
                 group as another sibling in that same outer group lets it
                 auto-flow into the now-empty cell next to "Job". -->
            <xpath expr="//field[@name='type_id']/ancestor::group[1]" position="after">
                <group string="Assessment">
                    <field name="x_assessment_link_received" string="Assessment Link Received"/>
                    <field name="x_assessment_taken"         string="Assessment Taken" invisible="x_assessment_link_received == 'no'"/>
                    <field name="x_assessment_feedback"      string="Assessment Feedback" invisible="x_assessment_link_received == 'no' or x_assessment_taken == 'no'"/>
                </group>
            </xpath>

            <!-- ── Hide Salary Package section ──────────────────────────
                 Confirmed name="recruitment_contract" from arch_db.
                 Using invisible="1" via attributes (NOT position="replace")
                 because replace errors when the element is absent in any
                 child view (e.g. interviewer form view id=656).
                 invisible hides it safely in all views that have it. -->
            <xpath expr="//group[@name='recruitment_contract']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Hide medium_id and campaign_id from Sourcing ─────────
                 source_id is re-added in Personal group above; the original
                 Sourcing group (incl. its source_id) is hidden in full via
                 its ancestor group below, so no separate rule is needed
                 here for source_id — adding one would also match (and
                 incorrectly hide) the new source_id field in Personal. -->
            <xpath expr="//field[@name='medium_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='campaign_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Hide "Applicant" group in Details tab ─────────────────
                 No @name on this group ("Applicant" / "Job" pair); anchor
                 on type_id (unique to this group) and walk up via
                 ancestor::group to hide the whole group. -->
            <xpath expr="//field[@name='type_id']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Hide "Sourcing" group in Details tab ──────────────────
                 No @name on this group ("Salary Package" / "Sourcing" pair);
                 anchor on medium_id (unique to Sourcing) and walk up via
                 ancestor::group to hide the whole group. -->
            <xpath expr="//field[@name='medium_id']/ancestor::group[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Hide Interviewers field ──────────────────────────────
                 invisible="1" via attributes (safe pattern, see note above). -->
            <xpath expr="//field[@name='interviewer_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Hide Tags field ───────────────────────────────────────
                 invisible="1" via attributes (safe pattern, see note above). -->
            <xpath expr="//field[@name='categ_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- ── Move the "Note" tab to the end ────────────────────────
                 "Details" (application_details) stays where it is;
                 "Note" (application_note) is moved to right after it,
                 becoming the last tab in the base notebook. -->
            <xpath expr="//page[@name='application_details']" position="after">
                <xpath expr="//page[@name='application_note']" position="move"/>
            </xpath>

            <!-- ── Hide the "Skills" tab (Recruitment Skills app) ────────
                 This page has no @name attribute and @string can't be
                 used as a selector, so target it via the unique field
                 it contains (current_applicant_skill_ids) and walk up
                 to the enclosing <page> with the ancestor:: axis. -->
            <xpath expr="//field[@name='current_applicant_skill_ids']/ancestor::page" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         LIST
    ══════════════════════════════════════════════════════════ -->
    <record id="hr_applicant_list_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.applicant.list.inherit.pipeline</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.crm_case_tree_view_job"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="x_role_status"          string="Role Status"          optional="show" readonly="1"/>
                <field name="x_sub_status"           string="Role Status Remarks"           optional="show" readonly="1"/>
                <field name="x_poc_id"               string="POC"                  optional="show" readonly="1"/>
                <field name="x_req_id"               string="Req ID"               optional="show" readonly="1"/>
                <field name="user_id"                string="Recruiter"            optional="show"/>
                <field name="x_client_portal_status" string="Client Portal Status" optional="show"/>
                <field name="partner_phone"          string="Contact Number"     optional="hide"/>
                <field name="x_skill_ids"            widget="many2many_tags" string="Skill"                optional="hide"/>
                <field name="x_current_organization" string="Current Organization" optional="hide"/>
                <field name="x_designation"          string="Designation"          optional="hide"/>
                <field name="x_current_location_id"  string="Current Location"     optional="hide"/>
                <field name="x_notice_period"        string="Notice Period"        optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         SEARCH (Recruitment Analysis)
    ══════════════════════════════════════════════════════════ -->
    <record id="hr_applicant_search_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.applicant.search.inherit.pipeline</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="x_poc_id"               string="POC"/>
                <field name="user_id"                string="Recruiter"/>
                <field name="x_req_id"               string="Req ID"/>
                <field name="partner_phone"          string="Contact Number"/>
                <field name="x_skill_ids"            string="Skill"/>
                <field name="x_current_organization" string="Current Organization"/>
                <field name="email_from"             string="Email"/>
            </xpath>
            <xpath expr="//filter[@name='department']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
            <xpath expr="//search/separator[1]" position="before">
                <separator/>
                <filter name="ps_active"
                        string="Active"
                        domain="[('x_role_status','=','active')]"/>
                <filter name="ps_in_progress"
                        string="In Progress"
                        domain="[('x_role_status','=','in_progress')]"/>
                <filter name="ps_on_hold"
                        string="On Hold"
                        domain="[('x_role_status','=','on_hold')]"/>
                <filter name="ps_closed"
                        string="Closed"
                        domain="[('x_role_status','=','closed')]"/>
                <separator/>
                <filter name="portal_uploaded"
                        string="Uploaded to Portal"
                        domain="[('x_client_portal_status','=','uploaded')]"/>
                <filter name="portal_not_uploaded"
                        string="Not Uploaded to Portal"
                        domain="[('x_client_portal_status','=','not_uploaded')]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter name="group_by_role_status"
                        string="Role Status"
                        context="{'group_by': 'x_role_status'}"/>
                <filter name="group_by_emp_type"
                        string="Employment Type"
                        context="{'group_by': 'x_employment_type'}"/>
                <filter name="group_by_portal_status"
                        string="Client Portal Status"
                        context="{'group_by': 'x_client_portal_status'}"/>
            </xpath>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════
         SEARCH (main Applications menu)
    ══════════════════════════════════════════════════════════ -->
    <record id="hr_applicant_search_bis_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.applicant.search.bis.inherit.pipeline</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search_bis"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="x_poc_id"               string="POC"/>
                <field name="user_id"                string="Recruiter"/>
                <field name="x_req_id"               string="Req ID"/>
                <field name="partner_phone"          string="Contact Number"/>
                <field name="x_skill_ids"            string="Skill"/>
                <field name="x_current_organization" string="Current Organization"/>
            </xpath>
            <xpath expr="//search/separator[1]" position="before">
                <separator/>
                <filter name="ps_active"
                        string="Active"
                        domain="[('x_role_status','=','active')]"/>
                <filter name="ps_in_progress"
                        string="In Progress"
                        domain="[('x_role_status','=','in_progress')]"/>
                <filter name="ps_on_hold"
                        string="On Hold"
                        domain="[('x_role_status','=','on_hold')]"/>
                <filter name="ps_closed"
                        string="Closed"
                        domain="[('x_role_status','=','closed')]"/>
                <separator/>
                <filter name="portal_uploaded"
                        string="Uploaded to Portal"
                        domain="[('x_client_portal_status','=','uploaded')]"/>
                <filter name="portal_not_uploaded"
                        string="Not Uploaded to Portal"
                        domain="[('x_client_portal_status','=','not_uploaded')]"/>
            </xpath>
            <xpath expr="//search/group" position="inside">
                <filter name="group_by_client"
                        string="Client"
                        context="{'group_by': 'department_id'}"/>
                <filter name="group_by_role_status"
                        string="Role Status"
                        context="{'group_by': 'x_role_status'}"/>
                <filter name="group_by_emp_type"
                        string="Employment Type"
                        context="{'group_by': 'x_employment_type'}"/>
                <filter name="group_by_portal_status"
                        string="Client Portal Status"
                        context="{'group_by': 'x_client_portal_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>
