<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view ──────────────────────────────────────────────────── -->
    <record id="view_applicant_tracker_list" model="ir.ui.view">
        <field name="name">recruitment.applicant.tracker.list</field>
        <field name="model">hr.applicant</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Applicant Tracker"
                  create="false" edit="true" delete="false" export_xlsx="0">

                <!-- Requisition Details -->
                <field name="x_rec_id"               string="Rec ID"               optional="show" readonly="1"/>
                <field name="department_id"           string="Client"               optional="show" readonly="1"/>
                <field name="job_id"                  string="Position / Role"      optional="show" readonly="1"/>
                <field name="x_employment_type"       string="Role Type"            optional="show" readonly="1"/>
                <field name="x_recruiter_id"          string="TE / Recruiter"       optional="show"/>

                <!-- Application Details -->
                <field name="source_id"               string="Source"               optional="show"/>
                <field name="create_date"             string="Application Date"     optional="show" readonly="1"/>
                <field name="stage_id"                string="Current Status"       optional="show"/>
                <field name="x_client_portal_status"  string="Client Portal Status" optional="show"
                       widget="badge"
                       decoration-success="x_client_portal_status == 'uploaded'"
                       decoration-danger="x_client_portal_status == 'not_uploaded'"/>

                <!-- Candidate Details -->
                <field name="partner_name"            string="Candidate Name"       optional="show"/>
                <field name="partner_phone"           string="Candidate Number"     optional="show"/>
                <field name="email_from"              string="Candidate Email"      optional="show"/>
                <field name="x_skill"                 string="Skill"                optional="show"/>
                <field name="x_total_experience"      string="Total Exp"            optional="show"/>
                <field name="x_relevant_experience"   string="Relevant Exp"         optional="show"/>
                <field name="x_current_organization"  string="Current Org"          optional="show"/>
                <field name="x_designation"           string="Designation"          optional="show"/>
                <field name="x_education"             string="Education"            optional="hide"/>

                <!-- Location & Availability -->
                <field name="x_current_location"      string="Current Location"     optional="show"/>
                <field name="x_preferred_location"    string="Preferred Location"   optional="hide"/>
                <field name="x_notice_period"         string="Notice Period"        optional="show"/>

                <!-- Compensation -->
                <field name="x_current_ctc"           string="Current CTC"          optional="show"/>
                <field name="x_expected_ctc"          string="Expected CTC"         optional="show"/>
                <field name="x_offer_in_hand"         string="Offer in Hand"        optional="hide"/>

                <!-- Additional -->
                <field name="x_remarks"               string="Remarks"              optional="hide"/>
            </list>
        </field>
    </record>

    <!-- NOTE: No standalone search view defined here.
         The action uses the inherited search view (hr_applicant_search_inherit_pipeline)
         defined in hr_applicant_view_inherit.xml, which already contains all required
         search fields and filters for the Applicant Tracker. -->

    <!-- ── Window action for Applicant Tracker list ───────────────────── -->
    <record id="action_applicant_tracker_list" model="ir.actions.act_window">
        <field name="name">Applicant Tracker</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_applicant_tracker_list')}),
        ]"/>
        <field name="search_view_id" ref="hr_applicant_search_inherit_pipeline"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No applicants found.</p>
            <p>Applicants will appear here once added to a job position.</p>
        </field>
    </record>

    <!-- ── Export wizard form ─────────────────────────────────────────── -->
    <record id="view_applicant_tracker_export_wizard_form" model="ir.ui.view">
        <field name="name">recruitment.applicant.tracker.export.wizard.form</field>
        <field name="model">recruitment.applicant.tracker.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Applicant Tracker">
                <sheet>
                    <group>
                        <group string="Date Range">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Filters">
                            <field name="department_ids" widget="many2many_tags"
                                   string="Clients"/>
                            <field name="job_ids"        widget="many2many_tags"
                                   string="Roles"/>
                            <field name="recruiter_ids"  widget="many2many_tags"
                                   string="Recruiters"
                                   domain="[('share','=',False)]"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_xlsx"
                            string="Export Excel"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Wizard action (dialog) ─────────────────────────────────────── -->
    <record id="action_applicant_tracker_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Applicant Tracker</field>
        <field name="res_model">recruitment.applicant.tracker.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_applicant_tracker_export_wizard_form"/>
    </record>

    <!-- ── "Export Excel" button bound to the Applicant Tracker list ─── -->
    <record id="action_applicant_tracker_export_xlsx" model="ir.actions.server">
        <field name="name">Export Excel</field>
        <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_model_id" ref="hr_recruitment.model_hr_applicant"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref('recruitment_pipeline_report.action_applicant_tracker_export_wizard').read()[0]</field>
    </record>

    <!-- ── Menu item ──────────────────────────────────────────────────── -->
    <menuitem
        id="menu_applicant_tracker"
        name="Applicant Tracker"
        parent="hr_recruitment.menu_hr_recruitment_root"
        action="action_applicant_tracker_list"
        sequence="99"/>

</odoo>
