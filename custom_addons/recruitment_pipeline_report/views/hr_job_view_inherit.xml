<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Job Position FORM -->
    <record id="hr_job_view_form_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.job.form.inherit.pipeline</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <!-- Job Position Name is required by default in Odoo, made
                 explicit here so it always shows the red asterisk. -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>

            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
                <attribute name="required">1</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="x_req_id_available" string="Req ID Available?" widget="radio" options="{'horizontal': true}"/>
                <field name="x_req_id"          string="Req ID"
                       readonly="x_req_id_available == 'no'"
                       required="x_req_id_available == 'yes'"
                       placeholder="Auto-generated on save"/>
                <field name="x_employment_type" string="Employment Type" required="1"/>
                <field name="x_poc_id"          string="Point of Contact (POC)"
                       context="{'default_x_client_department_id': department_id}"
                       required="1"/>
                <field name="x_role_status"     string="Role Status" required="1"/>
                <field name="x_sub_status"      string="Role Status Remarks" required="1"/>
                <field name="x_min_experience"  string="Min Experience (Yrs)" required="1"/>
                <field name="x_max_experience"  string="Max Experience (Yrs)" required="1"/>
                <field name="x_budget_lpa"      invisible="x_employment_type != 'fte'" required="x_employment_type == 'fte'"/>
                <field name="x_bill_rate_lpm"   invisible="x_employment_type != 'consulting'" required="x_employment_type == 'consulting'"/>
                <field name="x_location_ids"    widget="many2many_tags" string="Job Locations" options="{'no_create_edit': True}" required="1"/>
                <field name="x_skill_ids"       widget="many2many_tags" string="Required Skills" options="{'no_create_edit': True}" required="1"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="replace">
                <field name="x_recruiter_ids" widget="many2many_tags"
                       string="Recruiters"
                       options="{'no_create': True}"
                       required="1"/>
            </xpath>
            <!-- Hide native fields -->
            <xpath expr="//field[@name='contract_type_id']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='address_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='address_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//span[@invisible='address_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide native contract type group -->
            <xpath expr="//group[@name='contract']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide interviewers, email alias, and expected degree -->
            <xpath expr="//field[@name='interviewer_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//label[@for='alias_name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='alias_name']/.." position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='expected_degree']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Hide expected skills under job posting -->
            <xpath expr="//div[@name='recruitment_target']/following-sibling::field[@name='current_job_skill_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Job Position LIST (HR base) -->
    <record id="hr_job_view_list_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.job.list.inherit.pipeline</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_display_name"    string="Job Position"/>
                <field name="x_req_id"          string="Req ID"           optional="show"/>
                <field name="department_id"     string="Client"           optional="hide"/>
                <field name="x_employment_type" string="Employment Type"  optional="show"/>
                <field name="x_poc_id"          string="POC"              optional="show"/>
                <field name="x_role_status"     string="Role Status"      optional="show"/>
                <field name="x_sub_status"      string="Role Status Remarks"       optional="show"/>
                <field name="x_min_experience"  string="Min Exp (Yrs)"    optional="show"/>
                <field name="x_max_experience"  string="Max Exp (Yrs)"    optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Job Position LIST (Recruitment — primary list view) -->
    <record id="hr_job_view_recruitment_list_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.job.recruitment.list.inherit.pipeline</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_view_tree_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_display_name" string="Job Position"/>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="x_req_id"          string="Req ID"           optional="show"/>
                <field name="x_employment_type" string="Employment Type"  optional="show"/>
                <field name="x_poc_id"          string="POC"              optional="show"/>
                <field name="x_role_status"     string="Role Status"      optional="show"/>
                <field name="x_sub_status"      string="Role Status Remarks"       optional="show"/>
                <field name="x_min_experience"  string="Min Exp (Yrs)"   optional="show"/>
                <field name="x_max_experience"  string="Max Exp (Yrs)"   optional="show"/>
                <field name="x_recruiter_ids"   widget="many2many_tags"   optional="show"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="replace">
                <!-- Replaced by x_recruiter_ids above -->
            </xpath>
        </field>
    </record>

    <!-- Job Position KANBAN (Recruitment — default view) -->
    <record id="hr_job_view_recruitment_kanban_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.job.recruitment.kanban.inherit.pipeline</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_hr_job_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="x_display_name"/>
            </xpath>
            <xpath expr="//field[@name='name'][@class='fs-3']" position="replace">
                <field class="fs-3" name="x_display_name"/>
            </xpath>
            <xpath expr="//div[hasclass('col') and div/@groups='!base.group_multi_company']" position="replace">
                <div class="col">
                    <div groups="!base.group_multi_company">
                        <field name="x_recruiter_ids" widget="many2many_avatar_user"
                               options="{'display_avatar_name': True}"/>
                    </div>
                    <div groups="base.group_multi_company">
                        <t t-if="record.company_id.raw_value != 0">
                            <div class="d-flex flex-row align-items-center">
                                <field name="x_recruiter_ids" widget="many2many_avatar_user"
                                       options="{'display_avatar_name': False}"/>
                                <field class="ms-1" name="company_id"/>
                            </div>
                        </t>
                        <t t-else="">
                            <field name="x_recruiter_ids" widget="many2many_avatar_user"
                                   options="{'display_avatar_name': True}"/>
                        </t>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Job Position SEARCH -->
    <record id="hr_job_view_search_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.job.search.inherit.pipeline</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_job_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
            <xpath expr="//filter[@name='department']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="x_recruiter_ids" string="Recruiters"/>
                <field name="x_req_id"        string="Req ID"/>
            </xpath>
            <xpath expr="//filter[@name='employment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Job Positions sidebar search panel (Recruitment) -->
    <record id="hr_job_search_recruitment_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.job.search.recruitment.inherit.pipeline</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel//field[@name='department_id']" position="attributes">
                <attribute name="string">Client</attribute>
            </xpath>
        </field>
    </record>

    <!-- Hide native Employment Types menu -->
    <record id="hr.menu_view_hr_contract_type" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
    <record id="hr_recruitment.menu_hr_recruitment_contract_type" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

</odoo>
