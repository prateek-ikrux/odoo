<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_department_form_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.pipeline</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_poc_contacts"
                        type="object" icon="fa-address-book">
                    <field string="POC Contacts" name="x_poc_contact_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
