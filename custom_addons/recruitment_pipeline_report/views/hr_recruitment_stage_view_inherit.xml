<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Beside Hired Stage: outcome stages are where a candidate is meant to
         stay, so they should not send stuck reminders. -->
    <record id="hr_recruitment_stage_form_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.inherit.pipeline</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <field name="hired_stage" position="after">
                <field name="x_stage_reminders"/>
            </field>
        </field>
    </record>

    <record id="hr_recruitment_stage_tree_inherit_pipeline" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.list.inherit.pipeline</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_tree"/>
        <field name="arch" type="xml">
            <field name="hired_stage" position="after">
                <field name="x_stage_reminders" string="Stuck Reminders" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
