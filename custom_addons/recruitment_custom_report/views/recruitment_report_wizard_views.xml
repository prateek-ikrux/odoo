<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="recruitment_report_wizard_view_form" model="ir.ui.view">
        <field name="name">recruitment.report.wizard.form</field>
        <field name="model">recruitment.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Recruitment Report">
                <group>
                    <group>
                        <field name="report_type"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="date_filter_type"/>
                    </group>
                    <group>
                        <field name="job_ids" widget="many2many_tags"/>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="stage_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_report" string="Print PDF" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_recruitment_report_wizard" model="ir.actions.act_window">
        <field name="name">Recruitment Report</field>
        <field name="res_model">recruitment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_recruitment_report_wizard_pipeline" model="ir.actions.act_window">
        <field name="name">Pipeline Summary</field>
        <field name="res_model">recruitment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'pipeline'}</field>
    </record>

    <record id="action_recruitment_report_wizard_stage" model="ir.actions.act_window">
        <field name="name">Stage-wise Analysis</field>
        <field name="res_model">recruitment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'stage_analysis'}</field>
    </record>

    <record id="action_recruitment_report_wizard_activity" model="ir.actions.act_window">
        <field name="name">Recruitment Activity</field>
        <field name="res_model">recruitment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'activity', 'default_date_filter_type': 'modification'}</field>
    </record>

    <record id="action_recruitment_report_wizard_status" model="ir.actions.act_window">
        <field name="name">Applicant Status</field>
        <field name="res_model">recruitment.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_report_type': 'applicant_status'}</field>
    </record>

</odoo>
