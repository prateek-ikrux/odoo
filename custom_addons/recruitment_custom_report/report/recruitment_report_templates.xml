                            <td style="width:33%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#17a2b8;"><t t-esc="len(in_progress)"/></h2>
                                    <div>In Progress</div>
                                </div>
                            </td>
                            <td style="width:33%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#28a745;"><t t-esc="len(hired)"/></h2>
                                    <div>Hired / Closed</div>
                                </div>
                            </td>
                            <td style="width:33%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#dc3545;"><t t-esc="len(refused)"/></h2>
                                    <div>Refused</div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Overall status distribution stacked bar -->
                    <!-- <t t-if="total">
                        <t t-set="pct_in_progress" t-value="round(len(in_progress) * 100.0 / (total or 1), 1)"/>
                        <t t-set="pct_hired"       t-value="round(len(hired) * 100.0 / (total or 1), 1)"/>
                        <t t-set="pct_refused"     t-value="round(len(refused) * 100.0 / (total or 1), 1)"/>
                        <div class="rcr-section-title">Status Mix</div>
                        <div class="rcr-chart">
                            <div class="rcr-chart-track">
