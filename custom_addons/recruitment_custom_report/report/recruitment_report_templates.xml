                                Period: <t t-esc="date_from"/> – <t t-esc="date_to"/>
                                &amp;nbsp;|&amp;nbsp;
                            </t>
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y %H:%M')"/>
                            &amp;nbsp;|&amp;nbsp; Records: <t t-esc="len(docs)"/>
                        </div>
                    </div>

                    <t t-set="in_progress" t-value="docs.filtered(lambda a: a.active and not a.date_closed)"/>
                    <t t-set="hired"       t-value="docs.filtered(lambda a: a.date_closed)"/>
                    <t t-set="refused"     t-value="docs.filtered(lambda a: not a.active)"/>
                    <t t-set="total"       t-value="len(docs)"/>

