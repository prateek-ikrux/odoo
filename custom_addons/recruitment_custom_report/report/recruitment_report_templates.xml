<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         SHARED STYLES (injected into every report via inherit)
    ============================================================ -->
    <template id="recruitment_report_assets">
        <style>
            .rcr-header { border-bottom: 3px solid #2E75B6; margin-bottom: 16px; padding-bottom: 8px; }
            .rcr-title  { color: #2E75B6; font-size: 20px; font-weight: bold; }
            .rcr-subtitle { color: #666; font-size: 12px; }
            .rcr-kpi    { border: 1px solid #ddd; border-radius: 6px; padding: 12px; text-align: center; background: #f8f9fa; }
            .rcr-kpi h2 { margin: 0; font-size: 28px; }
            .rcr-section-title { background: #2E75B6; color: white; padding: 6px 10px; font-size: 13px;
                                  font-weight: bold; margin-top: 18px; margin-bottom: 0; }
            table.rcr-table { width: 100%; border-collapse: collapse; font-size: 11px; }
            table.rcr-table th { background: #2E75B6; color: white; padding: 5px 8px; text-align: left; }
            table.rcr-table td { padding: 4px 8px; border-bottom: 1px solid #eee; }
            table.rcr-table tr:nth-child(even) td { background: #f5f8fd; }
            .badge-progress { background:#17a2b8; color:white; padding:2px 7px; border-radius:10px; font-size:10px; }
            .badge-hired    { background:#28a745; color:white; padding:2px 7px; border-radius:10px; font-size:10px; }
            .badge-refused  { background:#dc3545; color:white; padding:2px 7px; border-radius:10px; font-size:10px; }
            .text-right     { text-align: right; }
            .text-center    { text-align: center; }
            .text-muted     { color: #888; font-size: 10px; }

            /* Lightweight chart styles (stacked bar) */
            .rcr-chart { margin: 4px 0 18px; font-size: 10px; }
            .rcr-chart-track {
                background: #f1f3f5;
                border-radius: 999px;
                height: 8px;
                overflow: hidden;
                font-size: 0;
            }
            .rcr-chart-seg {
                display: inline-block;
                height: 8px;
            }
            .rcr-chart-seg-progress { background: #17a2b8; }
            .rcr-chart-seg-hired    { background: #28a745; }
            .rcr-chart-seg-refused  { background: #dc3545; }
            .rcr-chart-legend {
                margin-top: 4px;
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }
            .rcr-chart-legend-item {
                display: flex;
                align-items: center;
                gap: 4px;
            }
            .rcr-chart-legend-swatch {
                width: 10px;
                height: 10px;
                border-radius: 2px;
            }
            .rcr-chart-legend-swatch.progress { background:#17a2b8; }
            .rcr-chart-legend-swatch.hired    { background:#28a745; }
            .rcr-chart-legend-swatch.refused  { background:#dc3545; }
        </style>
    </template>

    <!-- ============================================================
         1. PIPELINE SUMMARY REPORT
         Model: hr.applicant  (print from applicants list)
    ============================================================ -->
    <template id="rpt_pipeline">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="recruitment_custom_report.recruitment_report_assets"/>
                <div class="page">

                    <div class="rcr-header">
                        <div class="rcr-title">Recruitment Pipeline Summary</div>
                        <div class="rcr-subtitle">
                            <t t-if="date_from and date_to">
                                Period: <t t-esc="date_from"/> – <t t-esc="date_to"/>
                                &amp;nbsp;|&amp;nbsp;
                            </t>
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y %H:%M')"/>
                            &amp;nbsp;|&amp;nbsp; Records: <t t-esc="len(docs)"/>
                        </div>
                    </div>

                    <!-- KPI row -->
                    <t t-set="total"      t-value="len(docs)"/>
                    <t t-set="active_d"   t-value="docs.filtered(lambda a: a.active and not a.date_closed)"/>
                    <t t-set="hired_d"    t-value="docs.filtered(lambda a: a.date_closed)"/>
                    <t t-set="refused_d"  t-value="docs.filtered(lambda a: not a.active)"/>
                    <t t-set="jobs_d"     t-value="docs.mapped('job_id')"/>

                    <table style="width:100%;margin-bottom:16px;">
                        <tr>
                            <td style="width:25%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#2E75B6;"><t t-esc="total"/></h2>
                                    <div>Total Applicants</div>
                                </div>
                            </td>
                            <td style="width:25%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#17a2b8;"><t t-esc="len(active_d)"/></h2>
                                    <div>In Progress</div>
                                </div>
                            </td>
                            <td style="width:25%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#28a745;"><t t-esc="len(hired_d)"/></h2>
                                    <div>Hired / Closed</div>
                                </div>
                            </td>
                            <td style="width:25%;padding:4px;">
                                <div class="rcr-kpi">
                                    <h2 style="color:#6f42c1;"><t t-esc="len(jobs_d)"/></h2>
                                    <div>Job Positions</div>
                                </div>
                            </td>
                        </tr>
                    </table>

                    <!-- Status distribution stacked bar -->
                    <t t-if="total">
                        <t t-set="pct_in_progress" t-value="round(len(active_d) * 100.0 / (total or 1), 1)"/>
                        <t t-set="pct_hired"       t-value="round(len(hired_d) * 100.0 / (total or 1), 1)"/>
                        <t t-set="pct_refused"     t-value="round(len(refused_d) * 100.0 / (total or 1), 1)"/>
                        <div class="rcr-section-title">Status Distribution</div>
                        <div class="rcr-chart">
                            <div class="rcr-chart-track">
                                <!-- <div class="rcr-chart-seg rcr-chart-seg-progress"
                                     t-att-style="'width: %.1f%%;' % pct_in_progress"/>
                                <div class="rcr-chart-seg rcr-chart-seg-hired"
                                     t-att-style="'width: %.1f%%;' % pct_hired"/>
                                <div class="rcr-chart-seg rcr-chart-seg-refused"
                                     t-att-style="'width: %.1f%%;' % pct_refused"/> -->
                                <div class="rcr-chart-seg rcr-chart-seg-progress"
                                     t-att-style="'width: ' + str(pct_in_progress) + '%;'"/>
                                
                                <div class="rcr-chart-seg rcr-chart-seg-hired"
                                     t-att-style="'width: ' + str(pct_hired) + '%;'"/>
                                
                                <div class="rcr-chart-seg rcr-chart-seg-refused"
                                     t-att-style="'width: ' + str(pct_refused) + '%;'"/>
                            </div>
                            <div class="rcr-chart-legend">
                                <div class="rcr-chart-legend-item">
                                    <span class="rcr-chart-legend-swatch progress"/>
                                    <span>In Progress (<t t-esc="pct_in_progress"/>%)</span>
                                </div>
                                <div class="rcr-chart-legend-item">
                                    <span class="rcr-chart-legend-swatch hired"/>
                                    <span>Hired / Closed (<t t-esc="pct_hired"/>%)</span>
                                </div>
                                <div class="rcr-chart-legend-item">
                                    <span class="rcr-chart-legend-swatch refused"/>
                                    <span>Refused (<t t-esc="pct_refused"/>%)</span>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- By Job Position -->
                    <div class="rcr-section-title">Pipeline by Job Position</div>
                    <table class="rcr-table">
                        <thead>
                            <tr>
                                <th>Job Position</th>
                                <th>Department</th>
                                <th class="text-center">Total</th>
                                <th class="text-center">In Progress</th>
                                <th class="text-center">Hired</th>
                                <th class="text-center">Refused</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="jobs_d" t-as="job">
                                <t t-set="ja"  t-value="docs.filtered(lambda a: a.job_id == job)"/>
                                <t t-set="jip" t-value="ja.filtered(lambda a: a.active and not a.date_closed)"/>
                                <t t-set="jh"  t-value="ja.filtered(lambda a: a.date_closed)"/>
                                <t t-set="jr"  t-value="ja.filtered(lambda a: not a.active)"/>
                                <tr>
                                    <td><t t-esc="job.name"/></td>
                                    <td><t t-esc="job.department_id.name or '-'"/></td>
                                    <td class="text-center"><strong><t t-esc="len(ja)"/></strong></td>
                                    <td class="text-center" style="color:#17a2b8;"><t t-esc="len(jip)"/></td>
                                    <td class="text-center" style="color:#28a745;"><t t-esc="len(jh)"/></td>
                                    <td class="text-center" style="color:#dc3545;"><t t-esc="len(jr)"/></td>
                                </tr>
                            </t>
                            <t t-if="not jobs_d">
                                <tr><td colspan="6" class="text-center text-muted">No data found.</td></tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- By Stage -->
                    <div class="rcr-section-title" style="margin-top:18px;">Pipeline by Stage</div>
                    <table class="rcr-table">
                        <thead>
                            <tr>
                                <th>Stage</th>
                                <th class="text-center">Applicants</th>
                                <th class="text-center">% of Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs.mapped('stage_id').sorted('sequence')" t-as="stage">
                                <t t-set="sa"  t-value="docs.filtered(lambda a: a.stage_id == stage)"/>
                                <t t-set="pct" t-value="round(len(sa) * 100.0 / (total or 1), 1)"/>
                                <tr>
                                    <td><t t-esc="stage.name"/></td>
                                    <td class="text-center"><t t-esc="len(sa)"/></td>
                                    <td class="text-center"><t t-esc="pct"/>%</td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================
         2. STAGE-WISE ANALYSIS REPORT
    ============================================================ -->
    <template id="rpt_stage">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="recruitment_custom_report.recruitment_report_assets"/>
                <div class="page">

                    <div class="rcr-header">
                        <div class="rcr-title">Stage-wise Recruitment Analysis</div>
                        <div class="rcr-subtitle">
                            <t t-if="date_from and date_to">
                                Period: <t t-esc="date_from"/> – <t t-esc="date_to"/>
                                &amp;nbsp;|&amp;nbsp;
                            </t>
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y %H:%M')"/>
                            &amp;nbsp;|&amp;nbsp; Records: <t t-esc="len(docs)"/>
                        </div>
                    </div>

                    <t t-foreach="docs.mapped('stage_id').sorted('sequence')" t-as="stage">
                        <t t-set="sa" t-value="docs.filtered(lambda a: a.stage_id == stage)"/>
                        <div class="rcr-section-title">
                            <t t-esc="stage.name"/> — <t t-esc="len(sa)"/> applicant(s)
                        </div>
                        <table class="rcr-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Applicant</th>
                                    <th>Job Position</th>
                                    <th>Department</th>
                                    <th>Applied On</th>
                                    <th>Priority</th>
                                    <th>Responsible</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="sa" t-as="app">
                                    <tr>
                                        <td><t t-esc="app_index + 1"/></td>
                                        <td><t t-esc="app.partner_name or app.partner_id.name or '-'"/></td>
                                        <td><t t-esc="app.job_id.name or '-'"/></td>
                                        <td><t t-esc="app.department_id.name or '-'"/></td>
                                        <td><t t-esc="app.create_date and app.create_date.strftime('%Y-%m-%d') or '-'"/></td>
                                        <td>
                                            <t t-if="app.priority == '3'">★★★ Excellent</t>
                                            <t t-elif="app.priority == '2'">★★ Very Good</t>
                                            <t t-elif="app.priority == '1'">★ Good</t>
                                            <t t-else="">Normal</t>
                                        </td>
                                        <td><t t-esc="app.user_id.name or '-'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <t t-if="not docs">
                        <div class="text-muted text-center" style="margin-top:20px;">No applicants found.</div>
                    </t>

                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================
         3. RECRUITMENT ACTIVITY REPORT
    ============================================================ -->
    <template id="rpt_activity">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-call="recruitment_custom_report.recruitment_report_assets"/>
                <div class="page">

                    <div class="rcr-header">
                        <div class="rcr-title">Recruitment Activity Report</div>
                        <div class="rcr-subtitle">
                            <t t-if="date_from and date_to">
                                Period: <t t-esc="date_from"/> – <t t-esc="date_to"/>
                                &amp;nbsp;|&amp;nbsp;
                            </t>
                            Generated on <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d %b %Y %H:%M')"/>
                            &amp;nbsp;|&amp;nbsp; Records: <t t-esc="len(docs)"/>
                        </div>
                    </div>

                    <!-- By Recruiter -->
                    <div class="rcr-section-title">Summary by Recruiter</div>
                    <table class="rcr-table">
                        <thead>
                            <tr>
                                <th>Recruiter</th>
                                <th class="text-center">Assigned</th>
                                <th class="text-center">In Progress</th>
                                <th class="text-center">Hired</th>
                                <th class="text-center">Refused</th>
                                <th class="text-center">Avg Days to Close</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs.mapped('user_id')" t-as="user">
                                <t t-set="ua"  t-value="docs.filtered(lambda a: a.user_id == user)"/>
                                <t t-set="uip" t-value="ua.filtered(lambda a: a.active and not a.date_closed)"/>
                                <t t-set="uh"  t-value="ua.filtered(lambda a: a.date_closed)"/>
                                <t t-set="ur"  t-value="ua.filtered(lambda a: not a.active)"/>
                                <t t-set="dl"  t-value="[(a.date_closed - a.create_date).days for a in uh if a.date_closed and a.create_date]"/>
                                <tr>
                                    <td><t t-esc="user.name"/></td>
                                    <td class="text-center"><strong><t t-esc="len(ua)"/></strong></td>
                                    <td class="text-center" style="color:#17a2b8;"><t t-esc="len(uip)"/></td>
                                    <td class="text-center" style="color:#28a745;"><t t-esc="len(uh)"/></td>
                                    <td class="text-center" style="color:#dc3545;"><t t-esc="len(ur)"/></td>
                                    <td class="text-center">
                                        <t t-if="dl"><t t-esc="round(sum(dl) / len(dl), 1)"/></t>
                                        <t t-else="">-</t>
                                    </td>
                                </tr>
                            </t>
                            <t t-if="not docs.mapped('user_id')">
                                <tr><td colspan="6" class="text-center text-muted">No data.</td></tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Full detail -->
                    <div class="rcr-section-title" style="margin-top:18px;">Detailed Applicant List</div>
                    <table class="rcr-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Applicant</th>
                                <th>Job Position</th>
                                <th>Department</th>
                                <th>Stage</th>
                                <th>Responsible</th>
                                <th>Applied On</th>
                                <th>Closed On</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="app">
                                <tr>
                                    <td><t t-esc="app_index + 1"/></td>
                                    <td><t t-esc="app.partner_name or app.partner_id.name or '-'"/></td>
                                    <td><t t-esc="app.job_id.name or '-'"/></td>
                                    <td><t t-esc="app.department_id.name or '-'"/></td>
                                    <td><t t-esc="app.stage_id.name or '-'"/></td>
                                    <td><t t-esc="app.user_id.name or '-'"/></td>
                                    <td><t t-esc="app.create_date and app.create_date.strftime('%Y-%m-%d') or '-'"/></td>
                                    <td><t t-esc="app.date_closed and app.date_closed.strftime('%Y-%m-%d') or '-'"/></td>
                                    <td>
                                        <t t-if="not app.active"><span class="badge-refused">Refused</span></t>
                                        <t t-elif="app.date_closed"><span class="badge-hired">Hired</span></t>
                                        <t t-else=""><span class="badge-progress">In Progress</span></t>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================
         4. APPLICANT STATUS REPORT
    ============================================================ -->
