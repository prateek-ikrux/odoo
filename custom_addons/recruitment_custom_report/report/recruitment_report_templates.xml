                            </div>
                        </div>
                    </t> -->

                    <!-- In Progress -->
                    <t t-if="in_progress">
                        <div class="rcr-section-title" style="background:#17a2b8;">
                            In Progress (<t t-esc="len(in_progress)"/>)
                        </div>
                        <table class="rcr-table">
                            <thead>
                                <tr>
                                    <th>Applicant</th>
                                    <th>Job Position</th>
                                    <th>Current Stage</th>
                                    <th>Applied On</th>
                                    <th class="text-center">Days in Pipeline</th>
                                    <th>Priority</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="in_progress" t-as="app">
                                    <t t-set="days" t-value="(datetime.datetime.now() - app.create_date).days if app.create_date else 0"/>
                                    <tr>
                                        <td><t t-esc="app.partner_name or app.partner_id.name or '-'"/></td>
                                        <td><t t-esc="app.job_id.name or '-'"/></td>
                                        <td><t t-esc="app.stage_id.name or '-'"/></td>
                                        <td><t t-esc="app.create_date and app.create_date.strftime('%Y-%m-%d') or '-'"/></td>
                                        <td class="text-center">
                                            <t t-if="days > 30"><span style="color:#dc3545;font-weight:bold;"><t t-esc="days"/></span></t>
                                            <t t-else=""><t t-esc="days"/></t>
                                        </td>
                                        <td>
                                            <t t-if="app.priority == '3'">★★★</t>
                                            <t t-elif="app.priority == '2'">★★</t>
                                            <t t-elif="app.priority == '1'">★</t>
                                            <t t-else="">-</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Hired -->
                    <t t-if="hired">
                        <div class="rcr-section-title" style="background:#28a745;margin-top:18px;">
                            Hired / Closed (<t t-esc="len(hired)"/>)
                        </div>
                        <table class="rcr-table">
                            <thead>
                                <tr>
                                    <th>Applicant</th>
                                    <th>Job Position</th>
                                    <th>Department</th>
                                    <th>Applied On</th>
                                    <th>Date Closed</th>
                                    <th class="text-center">Days to Hire</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="hired" t-as="app">
                                    <t t-set="dth" t-value="(app.date_closed - app.create_date).days if app.date_closed and app.create_date else '-'"/>
                                    <tr>
                                        <td><t t-esc="app.partner_name or app.partner_id.name or '-'"/></td>
                                        <td><t t-esc="app.job_id.name or '-'"/></td>
                                        <td><t t-esc="app.department_id.name or '-'"/></td>
                                        <td><t t-esc="app.create_date and app.create_date.strftime('%Y-%m-%d') or '-'"/></td>
                                        <td><t t-esc="app.date_closed and app.date_closed.strftime('%Y-%m-%d') or '-'"/></td>
                                        <td class="text-center"><t t-esc="dth"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Refused -->
                    <t t-if="refused">
                        <div class="rcr-section-title" style="background:#dc3545;margin-top:18px;">
                            Refused / Archived (<t t-esc="len(refused)"/>)
                        </div>
                        <table class="rcr-table">
                            <thead>
                                <tr>
                                    <th>Applicant</th>
                                    <th>Job Position</th>
                                    <th>Department</th>
                                    <th>Refuse Reason</th>
                                    <th>Applied On</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="refused" t-as="app">
                                    <tr>
                                        <td><t t-esc="app.partner_name or app.partner_id.name or '-'"/></td>
                                        <td><t t-esc="app.job_id.name or '-'"/></td>
                                        <td><t t-esc="app.department_id.name or '-'"/></td>
                                        <td><t t-esc="app.refuse_reason_id.name or '-'"/></td>
                                        <td><t t-esc="app.create_date and app.create_date.strftime('%Y-%m-%d') or '-'"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                </div>
            </t>
        </t>
    </template>

</odoo>
